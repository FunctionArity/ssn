<% header_bg = guard.open? ? "bg-gradient-to-r from-indigo-50 to-white" : "bg-gradient-to-r from-gray-100 to-white" %>
<div class="px-6 py-5 flex items-center justify-between gap-4 <%= header_bg %> border-b border-gray-100">
  <div class="flex items-center gap-4 min-w-0">
    <div class="flex items-center justify-center w-12 h-12 rounded-full shrink-0 <%= guard.open? ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-200 text-gray-400' %>">
      <i class="ph ph-calendar-check text-xl"></i>
    </div>
    <div class="min-w-0">
      <p class="text-xs font-medium text-indigo-400 uppercase tracking-wide"><%= l(guard.due_date, format: :long) %></p>
      <h2 class="text-2xl font-bold text-gray-900 mt-0.5">
        # <%= guard.day_number %>
        <%= " #{content_tag(:i, '', class: 'ph ph-lock-simple text-lg text-gray-400 align-middle')}".html_safe if guard.closed? %>
      </h2>
      <p class="text-xs text-gray-400 mt-0.5">
        <%= guard.number %>
      </p>
    </div>
  </div>
  <span class="flex items-center gap-1 text-xs text-gray-400 shrink-0">
    <i class="ph ph-hand-heart"></i> <%= services_count %> <%= t("guards.index.services_count", count: services_count) %>
  </span>
</div>

