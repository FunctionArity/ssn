<% if services.any? %>
  <div id="guard_<%= guard.id %>_services" data-copy-text="<%= guard_services_clipboard_text(guard, services) %>" data-controller="service-reorder" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% services.each do |service| %>
      <% colors = service_colors(service) %>
      <div id="<%= dom_id(service, :row) %>"
           data-service-reorder-target="row"
           data-service-id="<%= service.id %>"
           draggable="true"
           data-action="dragstart->service-reorder#dragStart dragend->service-reorder#dragEnd dragover->service-reorder#dragOver dragleave->service-reorder#dragLeave drop->service-reorder#drop"
           class="flex flex-col bg-white border <%= colors[:frame] %> rounded-xl shadow-sm hover:shadow-md transition-all duration-200 hover:-translate-y-0.5 overflow-hidden">

        <div class="<%= colors[:header] %> border-b border-gray-100">
          <div class="flex items-center justify-center py-1 <%= colors[:grip] %> cursor-grab" title="Arrastrar para reordenar">
            <i class="ph-bold ph-dots-six-vertical text-lg"></i>
          </div>
          <div class="px-5 pb-4 flex items-center justify-between">
            <div class="min-w-0 pr-3">
              <p class="text-xs font-medium <%= colors[:date] %> uppercase tracking-wide"><%= l(service.due_date, format: :long) %></p>
              <p class="text-base font-bold text-gray-900 truncate mt-0.5"><%= service.full_name %></p>
            </div>
            <div class="flex flex-col items-end gap-2 shrink-0">
              <span class="<%= colors[:badge] %>"><%= t("services.status.#{service.status}") %></span>
              <div class="flex items-center justify-center w-8 h-8 rounded-full <%= colors[:icon] %>">
                <span class="text-sm font-semibold"><%= service.position %></span>
              </div>
            </div>
          </div>
        </div>

        <%# The Urgente badge sits at the top right, over the details, so every card keeps the same height; the details
           truncate before it, thanks to the padding. %>
        <% urgent_badge = service_urgent_badge(service) %>
        <div class="relative px-5 py-4 flex flex-col gap-3 grow <%= "pr-28" if urgent_badge %>">
          <% if urgent_badge %>
            <div class="absolute top-4 right-5"><%= urgent_badge %></div>
          <% end %>
          <% if service.health_facility.present? %>
            <div class="flex items-center gap-2">
              <div class="flex items-center justify-center w-7 h-7 rounded-full bg-teal-100 text-teal-600 shrink-0">
                <i class="ph ph-hospital text-xs"></i>
              </div>
              <div class="min-w-0">
                <p class="text-xs text-gray-400"><%= Service.human_attribute_name(:health_facility) %></p>
                <% hf_address = service.health_facility.address.presence || service.health_facility.name %>
                <%= link_to service.health_facility.name, "https://maps.google.com/?q=#{URI.encode_uri_component(hf_address)}", target: "_blank", rel: "noopener", class: "text-sm font-medium text-indigo-600 hover:underline truncate block" %>
              </div>
            </div>
          <% elsif service.address.present? %>
            <div class="flex items-center gap-2">
              <div class="flex items-center justify-center w-7 h-7 rounded-full bg-gray-100 text-gray-500 shrink-0">
                <i class="ph ph-map-pin text-xs"></i>
              </div>
              <div class="min-w-0">
                <p class="text-xs text-gray-400"><%= Service.human_attribute_name(:address) %></p>
                <%= link_to service.address, "https://maps.google.com/?q=#{URI.encode_uri_component(service.address)}", target: "_blank", rel: "noopener", class: "text-sm font-medium text-indigo-600 hover:underline truncate block" %>
              </div>
            </div>
          <% end %>

          <% if service.pathology.present? %>
            <div class="flex items-center gap-2">
              <div class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 shrink-0">
                <i class="ph ph-heartbeat text-xs"></i>
              </div>
              <div class="min-w-0">
                <p class="text-xs text-gray-400"><%= Service.human_attribute_name(:pathology) %></p>
                <p class="text-sm text-gray-700 truncate"><%= service.pathology %></p>
              </div>
            </div>
          <% end %>
        </div>

        <div class="px-5 py-3 border-t border-gray-100 flex items-center justify-between">
          <%# As tall as the Completar button, so cards without it keep the same height. %>
          <div class="flex items-center gap-2 min-h-8">
            <% if service.can_be_completed? %>
              <%= button_to complete_service_path(service), method: :post, form: { data: {
                turbo_confirm: t("services.show.complete_confirm"),
                turbo_confirm_title: t("services.show.complete_confirm_title"),
                turbo_confirm_level: "danger" } },
                            class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-red-600 px-3 py-1.5 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
                <%= t("services.show.complete") %>
              <% end %>
            <% end %>
          </div>
          <%= link_to service, class: "flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-800" do %>
            <i class="ph ph-arrow-right"></i> <%= t("services.index.show") %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p id="guard_<%= guard.id %>_services" data-copy-text="<%= guard_services_clipboard_text(guard, services) %>" class="text-sm text-gray-400">No hay servicios registrados para esta guardia.</p>
<% end %>
