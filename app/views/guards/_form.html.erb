<%= form_with(model: guard, class: "space-y-6") do |form| %>
  <% if guard.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-800 rounded-lg p-4">
      <h2 class="font-semibold mb-2"><%= t("guards.form.errors.title", count: guard.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% guard.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :day, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.date_field :day, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :vocal_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.collection_select :vocal_id, User.vocal, :id, ->(u) { "#{u.first_name} #{u.last_name}" }, { prompt: t("guards.form.select_vocal") }, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :priest_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.collection_select :priest_id, User.priest, :id, ->(u) { "#{u.first_name} #{u.last_name}" }, { prompt: t("guards.form.select_priest") }, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <span class="block text-sm font-medium text-gray-700 mb-1"><%= Guard.human_attribute_name(:guardians) %></span>
    <div class="space-y-2">
      <% User.guardian.each do |user| %>
        <label class="flex items-center gap-2">
          <%= check_box_tag "guard[guardian_ids][]", user.id, guard.guardian_ids.include?(user.id), class: "rounded border-gray-300 text-blue-600 focus:ring-blue-500" %>
          <span class="text-sm text-gray-700"><%= user.first_name %> <%= user.last_name %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :notes, rows: 3, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>
<% end %>
