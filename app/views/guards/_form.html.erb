<%= form_with(model: guard, class: "space-y-6", data: { turbo_frame: "_top" }) do |form| %>
  <% if guard.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-800 rounded-lg p-4">
      <h2 class="font-semibold mb-2"><%= t("guards.form.errors.title", count: guard.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% guard.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <% if guard.new_record? %>
    <%= form.hidden_field :guard_setup_id %>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :due_date, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.date_field :due_date,
            class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500",
            data: guard.new_record? ? {
              controller: "guard-date-reload",
              action: "change->guard-date-reload#reload",
              guard_date_reload_url_value: new_guard_path
            } : {} %>
    </div>
    <div>
      <%= form.label :day_number, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.number_field :day_number, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 bg-gray-100 cursor-not-allowed", readonly: true %>
    </div>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :vocal, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.collection_select :vocal_id, User.vocal, :id, ->(u) { "#{u.first_name} #{u.last_name}" }, { prompt: t("guards.form.select_vocal") }, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    </div>
    <div>
      <%= form.label :priest, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.collection_select :priest_id, User.priest, :id, ->(u) { "#{u.first_name} #{u.last_name}" }, { prompt: t("guards.form.select_priest") }, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    </div>
  </div>

  <div data-controller="guardian-search"
       data-guardian-search-guardians-value="<%= User.guardian.map { |u| { id: u.id, name: "#{u.first_name} #{u.last_name}" } }.to_json %>"
       data-guardian-search-selected-value="<%= guard.guardian_ids.to_json %>">
    <span class="block text-sm font-medium text-gray-700 mb-1"><%= Guard.human_attribute_name(:guardians) %></span>
    <div class="relative">
      <input type="text"
             data-guardian-search-target="input"
             data-action="input->guardian-search#filter keydown->guardian-search#navigate"
             placeholder="<%= t('guards.form.search_guardians', default: 'Search guardians...') %>"
             autocomplete="off"
             class="w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
      <div data-guardian-search-target="dropdown"
           class="hidden absolute z-10 mt-1 w-full rounded-md border border-gray-200 bg-white shadow-lg max-h-48 overflow-y-auto"></div>
    </div>
    <div data-guardian-search-target="selectedList" class="flex flex-wrap gap-2 mt-2"></div>
  </div>

<div>
    <%= form.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :notes, rows: 3, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div class="border-t border-gray-100 pt-4 flex justify-end">
    <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors" %>
  </div>
<% end %>
