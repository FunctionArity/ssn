<div>
  <%= render "shared/page_header",
        title: t(".title"),
        icon: "ph-calendar-check",
        icon_class: "bg-indigo-100 text-indigo-700",
        action_label: t(".new_guard"),
        action_path: new_guard_path %>

  <div id="guards" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
    <% @guards.each do |guard| %>
      <div class="bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 hover:-translate-y-0.5 overflow-hidden flex flex-col">

        <div class="px-5 py-4 flex items-center justify-between bg-gradient-to-r from-indigo-50 to-white border-b border-gray-100">
          <div>
            <p class="text-xs font-medium text-indigo-400 uppercase tracking-wide"><%= l(guard.due_date, format: :long) %></p>
            <p class="text-2xl font-bold text-gray-900"># <%= guard.day_number %></p>
          </div>
          <div class="flex items-center justify-center w-10 h-10 rounded-full bg-indigo-100 text-indigo-700">
            <i class="ph ph-calendar-check text-lg"></i>
          </div>
        </div>

        <div class="px-5 py-4 flex flex-col gap-3 grow">
          <div class="flex items-center gap-2">
            <div class="flex items-center justify-center w-7 h-7 rounded-full bg-purple-100 text-purple-600 shrink-0">
              <i class="ph ph-cross text-xs"></i>
            </div>
            <div class="min-w-0">
              <p class="text-xs text-gray-400"><%= Guard.human_attribute_name(:priest) %></p>
              <p class="text-sm font-medium text-gray-900 truncate"><%= guard.priest.full_name %></p>
            </div>
          </div>

          <div class="flex items-center gap-2">
            <div class="flex items-center justify-center w-7 h-7 rounded-full bg-red-100 text-red-600 shrink-0">
              <i class="ph ph-user text-xs"></i>
            </div>
            <div class="min-w-0">
              <p class="text-xs text-gray-400"><%= Guard.human_attribute_name(:vocal) %></p>
              <p class="text-sm font-medium text-gray-900 truncate"><%= guard.vocal.full_name %></p>
            </div>
          </div>

          <div class="flex items-start gap-2">
            <div class="flex items-center justify-center w-7 h-7 rounded-full bg-green-100 text-green-600 shrink-0 mt-0.5">
              <i class="ph ph-users text-xs"></i>
            </div>
            <div class="min-w-0">
              <div class="flex flex-wrap gap-1 mt-1">
                <% guard.guardians.order(:last_name, :first_name).each do |guardian| %>
                  <span class="badge_green"><%= guardian.full_name %></span>
                <% end %>
              </div>
            </div>
          </div>
        </div>

        <div class="px-5 py-3 border-t border-gray-100 flex items-center justify-between">
          <span class="flex items-center gap-1 text-xs text-gray-400">
            <i class="ph ph-first-aid"></i>
            <%= @services_count_by_guard[guard.id] || 0 %> <%= t("guards.index.services_count", count: @services_count_by_guard[guard.id] || 0) %>
          </span>
          <%= link_to guard, class: "flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-800" do %>
            <i class="ph ph-arrow-right"></i> <%= t(".show") %>
          <% end %>
        </div>

      </div>
    <% end %>
  </div>
</div>
