<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to guards_path, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <% header_bg = @guard.open? ? "bg-gradient-to-r from-indigo-50 to-white" : "bg-gradient-to-r from-gray-100 to-white" %>
  <div id="<%= dom_id @guard %>" class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">

    <div class="px-6 py-5 flex items-center justify-between <%= header_bg %> border-b border-gray-100">
      <div>
        <p class="text-xs font-medium text-indigo-400 uppercase tracking-wide"><%= l(@guard.due_date, format: :long) %></p>
        <h2 class="text-2xl font-bold text-gray-900 mt-0.5"># <%= @guard.day_number %><%= " #{content_tag(:i, '', class: 'ph ph-lock-simple text-lg text-gray-400 align-middle')}".html_safe if @guard.closed? %></h2>
      </div>
      <div class="flex flex-col items-end gap-2">
        <div class="flex items-center justify-center w-12 h-12 rounded-full <%= @guard.open? ? 'bg-indigo-100 text-indigo-700' : 'bg-gray-200 text-gray-400' %>">
          <i class="ph ph-calendar-check text-xl"></i>
        </div>
        <span class="flex items-center gap-1 text-xs text-gray-400">
          <i class="ph ph-hand-heart"></i> <%= @services_count %> <%= t("guards.index.services_count", count: @services_count) %>
        </span>
      </div>
    </div>

    <div class="divide-y divide-gray-100">
      <div class="px-6 py-4 flex items-center gap-4">
        <% if @guard.open? %>
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-green-100 text-green-600 shrink-0">
            <i class="ph ph-shield-check text-sm"></i>
          </div>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Guard.human_attribute_name(:status) %></p>
            <div class="flex items-center gap-1.5 mt-0.5">
              <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>
              <p class="text-sm font-semibold text-green-700"><%= t("guards.status.open") %></p>
            </div>
          </div>
        <% else %>
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-400 shrink-0">
            <i class="ph ph-lock-simple text-sm"></i>
          </div>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Guard.human_attribute_name(:status) %></p>
            <p class="text-sm font-semibold text-gray-500 mt-0.5"><%= t("guards.status.closed") %></p>
          </div>
        <% end %>
      </div>

      <div class="px-6 py-4 flex items-center gap-4">
        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-purple-100 text-purple-600 shrink-0">
          <i class="ph ph-cross text-sm"></i>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Guard.human_attribute_name(:priest) %></p>
          <p class="text-sm font-semibold text-gray-900 mt-0.5"><%= link_to @guard.priest.full_name, @guard.priest %></p>
        </div>
      </div>

      <div class="px-6 py-4 flex items-center gap-4">
        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-red-100 text-red-600 shrink-0">
          <i class="ph ph-user text-sm"></i>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Guard.human_attribute_name(:vocal) %></p>
          <p class="text-sm font-semibold text-gray-900 mt-0.5"><%= link_to @guard.vocal.full_name, @guard.vocal %></p>
        </div>
      </div>

      <div class="px-6 py-4">
        <div class="flex items-center gap-4 mb-3">
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-green-100 text-green-600 shrink-0">
            <i class="ph ph-users text-sm"></i>
          </div>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Guard.human_attribute_name(:guardians) %></p>
          </div>
        </div>
        <div class="flex flex-wrap gap-2 pl-12">
          <% @guard.guardians.order(:last_name, :first_name).each do |guardian| %>
            <span class="badge_green"><%= link_to guardian.full_name, guardian %></span>
          <% end %>
        </div>
      </div>

      <% if @guard.notes.present? %>
        <div class="px-6 py-4 flex items-start gap-4">
          <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500 shrink-0">
            <i class="ph ph-note text-sm"></i>
          </div>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Guard.human_attribute_name(:notes) %></p>
            <p class="text-sm text-gray-700 mt-0.5"><%= @guard.notes %></p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-end gap-3">
      <%= link_to t("edit"), edit_guard_path(@guard), class: "flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
      <%= link_to pdf_guard_path(@guard), target: "_blank", class: "flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
        <i class="ph ph-printer text-red-500"></i> <%= t(".print_pdf") %>
      <% end %>
      <% if @guard.open? %>
        <%= button_to close_guard_path(@guard), method: :post, form: { data: { turbo_confirm: t(".close_confirm") } }, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500" do %>
          <i class="ph ph-check-circle"></i> <%= t(".close_guard") %>
        <% end %>
      <% end %>
      <%= button_to @guard, method: :delete, form: { data: { turbo_confirm: t(".destroy_confirm") } }, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
        <i class="ph ph-trash"></i> <%= t("destroy") %>
      <% end %>
    </div>
  </div>

  <div class="mt-8">
    <div class="flex items-center justify-between mb-3">
      <h2 class="text-sm font-semibold text-gray-700 uppercase tracking-wide">Servicios</h2>
      <%= link_to new_service_path(guard_id: @guard.id), class: "flex items-center gap-1 text-sm font-medium text-indigo-600 hover:text-indigo-800" do %>
        <i class="ph ph-plus"></i> Nuevo servicio
      <% end %>
    </div>

    <% if @services.any? %>
      <div class="bg-white border border-gray-200 rounded-xl overflow-hidden divide-y divide-gray-100">
        <% @services.each do |service| %>
          <%= link_to service, class: "flex items-center gap-4 px-4 py-3 hover:bg-gray-50 transition-colors" do %>
            <% icon_class = service.pending? ? "bg-red-100 text-red-600" : "bg-green-100 text-green-600" %>
            <div class="flex items-center justify-center w-8 h-8 rounded-full <%= icon_class %> shrink-0">
              <i class="ph ph-hand-heart text-sm"></i>
            </div>
            <div class="flex-1 min-w-0">
              <p class="text-sm font-medium text-gray-900 truncate"><%= service.full_name %></p>
              <p class="text-xs text-gray-400 mt-0.5"><%= l(service.due_date, format: :long) %><%= " · #{service.health_facility.name}" if service.health_facility.present? %></p>
            </div>
            <% status_class = service.pending? ? "badge_red" : "badge_green" %>
            <span class="<%= status_class %> shrink-0"><%= t("services.status.#{service.status}") %></span>
            <i class="ph ph-caret-right text-gray-400 shrink-0"></i>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-gray-400">No hay servicios registrados para esta guardia.</p>
    <% end %>
  </div>
</div>
