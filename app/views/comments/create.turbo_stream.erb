<% if @comment.persisted? %>
  <% locals = { comment: @comment, replies_by_parent: {}, unread_comment_ids: [] } %>
  <% if @comment.parent %>
    <%= turbo_stream.prepend dom_id(@comment.parent, :replies), partial: "comments/comment", locals: locals %>
  <% else %>
    <%= turbo_stream.remove dom_id(@commentable, :comments_empty) %>
    <%= turbo_stream.prepend dom_id(@commentable, :comments), partial: "comments/comment", locals: locals %>
  <% end %>
  <%= turbo_stream.replace dom_id(@commentable, :comment_form), partial: "comments/form", locals: { commentable: @commentable, comment: Comment.new } %>
<% else %>
  <%= turbo_stream.replace dom_id(@commentable, :comment_form), partial: "comments/form", locals: { commentable: @commentable, comment: @comment } %>
<% end %>
