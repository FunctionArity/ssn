<%# One comment, without its replies. locals: comment, unread (whether it mentions the current user and they
    haven't read it yet). An unread comment is marked read by clicking it, or pressing Enter on it. %>
<% read_attributes = unread ? {
     tabindex: 0,
     title: t("comments.comment.mark_read"),
     data: { controller: "mark-read", action: "click->mark-read#read keydown.enter->mark-read#read",
             mark_read_url_value: polymorphic_path([ :read, comment.commentable, comment ]) }
   } : {} %>
<%= tag.div id: dom_id(comment), class: [ "flex gap-3 px-6 py-4", ("bg-amber-50/60 cursor-pointer hover:bg-amber-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-blue-500" if unread) ], **read_attributes do %>
  <%# The author's picture, or their role icon when they have none or it fails to load. %>
  <% role_icon = capture do %>
    <i class="ph <%= comment.user.role_icon_class %> <%= comment.user.role_icon_color_class %>"></i>
  <% end %>
  <% if comment.user.avatar.attached? %>
    <div data-controller="avatar-fallback" class="shrink-0">
      <%= image_tag url_for(comment.user.avatar), alt: "", class: "w-8 h-8 rounded-full object-cover",
            data: { avatar_fallback_target: "image", action: "error->avatar-fallback#fallback" } %>
      <div data-avatar-fallback-target="placeholder" class="hidden items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500"><%= role_icon %></div>
    </div>
  <% else %>
    <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500 shrink-0"><%= role_icon %></div>
  <% end %>
  <div class="min-w-0 flex-1">
    <div class="flex flex-wrap items-center gap-x-2 gap-y-0.5">
      <%= link_to comment.user.full_name, comment.user, class: "text-sm font-semibold text-gray-900 hover:underline" %>
      <time datetime="<%= comment.created_at.iso8601 %>" title="<%= l(comment.created_at, format: :long) %>" class="text-xs text-gray-400">
        <%= l(comment.created_at, format: :short) %>
      </time>
      <% if comment.was_edited? %>
        <span class="text-xs text-gray-400" title="<%= l(comment.updated_at, format: :long) %>"><%= t("comments.comment.edited") %></span>
      <% end %>
      <% if unread %>
        <span class="badge_red"><%= t("comments.comment.new") %></span>
      <% end %>
      <%# Replies are to other people's comments. %>
      <% if comment.user != current_user %>
        <%= tag.button type: "button",
              class: "cursor-pointer ml-auto flex items-center gap-1 text-xs font-medium text-gray-500 hover:text-blue-600",
              title: t("comments.comment.reply"),
              aria: { label: t("comments.comment.reply") },
              data: { action: "comment-reply#reply",
                      comment_reply_body_param: comment.reply_body_for(current_user),
                      comment_reply_parent_id_param: comment.id,
                      comment_reply_author_param: comment.user.full_name } do %>
          <i class="ph ph-arrow-bend-up-left"></i>
        <% end %>
      <% end %>
      <%# Own comments, while nobody has replied, are edited in place. %>
      <% editable = policy(comment).edit? %>
      <% if editable %>
        <%= link_to edit_polymorphic_path([ comment.commentable, comment ]),
              data: { turbo_stream: true },
              class: "ml-auto flex items-center text-gray-400 hover:text-blue-600",
              title: t("comments.comment.edit"),
              aria: { label: t("comments.comment.edit") } do %>
          <i class="ph ph-pencil-simple"></i>
        <% end %>
      <% end %>
      <% if policy(comment).destroy? %>
        <%= button_to polymorphic_path([ comment.commentable, comment ]), method: :delete,
              form: { class: ("ml-auto" if comment.user == current_user && !editable), data: { turbo_confirm: t("comments.comment.destroy_confirm"), turbo_confirm_title: t("comments.comment.destroy_confirm_title"), turbo_confirm_level: "danger" } },
              class: "cursor-pointer flex items-center text-gray-400 hover:text-red-600",
              title: t("comments.comment.destroy"),
              aria: { label: t("comments.comment.destroy") } do %>
          <i class="ph ph-trash"></i>
        <% end %>
      <% end %>
    </div>
    <div class="lexxy-content text-sm text-gray-700 mt-1 break-words"><%= comment_body_html(comment) %></div>
  </div>
<% end %>
