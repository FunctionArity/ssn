<%= form_with(model: health_facility, class: "space-y-6") do |form| %>
  <% if health_facility.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-800 rounded-lg p-4">
      <h2 class="font-semibold mb-2"><%= t("health_facilities.form.errors.title", count: health_facility.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% health_facility.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div data-controller="address-map"
       data-address-map-initial-address-value="<%= health_facility.address %>">
    <%= form.label :address, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :address,
          data: { address_map_target: "input", action: "input->address-map#search" },
          class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    <div data-address-map-target="map"
         class="mt-2 rounded-md overflow-hidden border border-gray-200"
         style="height: 400px;"></div>
  </div>

  <div class="border-t border-gray-100 pt-4 flex justify-end">
    <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors" %>
  </div>
<% end %>
