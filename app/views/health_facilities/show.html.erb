<div class="py-8 max-w-xl">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to health_facilities_path, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <div id="<%= dom_id @health_facility %>" class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-5 flex items-center justify-between bg-gradient-to-r from-teal-50 to-white border-b border-gray-100">
      <div>
        <p class="text-xs font-medium text-teal-500 uppercase tracking-wide"><%= HealthFacility.human_attribute_name(:name) %></p>
        <h2 class="text-xl font-bold text-gray-900 mt-0.5"><%= @health_facility.name %></h2>
      </div>
      <div class="flex items-center justify-center w-12 h-12 rounded-full bg-teal-100 text-teal-700 shrink-0">
        <i class="ph ph-hospital text-xl"></i>
      </div>
    </div>

    <div class="px-6 py-4 flex items-start gap-4 border-b border-gray-100">
      <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500 shrink-0 mt-0.5">
        <i class="ph ph-map-pin text-sm"></i>
      </div>
      <div>
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= HealthFacility.human_attribute_name(:address) %></p>
        <p class="text-sm text-gray-900 mt-0.5"><%= @health_facility.address %></p>
      </div>
    </div>

    <% if @health_facility.address.present? %>
      <div data-controller="address-map"
           data-address-map-initial-address-value="<%= @health_facility.address %>">
        <div data-address-map-target="map" class="w-full h-72"></div>
      </div>
    <% end %>

    <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-end gap-3">
      <%= link_to edit_health_facility_path(@health_facility), class: "flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
        <i class="ph ph-pencil-simple"></i> <%= t("edit") %>
      <% end %>
      <%= button_to @health_facility, method: :delete, form: { data: { turbo_confirm: t(".destroy_confirm") } }, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
        <i class="ph ph-trash"></i> <%= t("destroy") %>
      <% end %>
    </div>
  </div>
</div>
