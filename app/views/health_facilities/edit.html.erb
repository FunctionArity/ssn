<div class="py-8">
  <h1 class="text-2xl font-bold mb-6"><%= t(".title") %></h1>

  <%= render "form", health_facility: @health_facility %>

  <div class="mt-6 flex gap-4">
    <%= link_to @health_facility, class: "flex items-center gap-1 text-blue-600 hover:underline" do %>
      <i class="ph ph-eye"></i> <%= t(".show") %>
    <% end %>
    <%= link_to t(".back"), health_facilities_path, class: "text-blue-600 hover:underline" %>
  </div>
</div>
