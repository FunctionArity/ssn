<div class="py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <%= link_to t(".new_health_facility"), new_health_facility_path, class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>

  <div id="health_facilities" class="space-y-4">
    <% @health_facilities.each do |health_facility| %>
      <div class="border border-gray-200 rounded-lg p-4 flex items-center justify-between">
        <div>
          <p class="font-semibold"><%= health_facility.name %></p>
          <p class="text-sm text-gray-500"><%= health_facility.address %></p>
        </div>
        <%= link_to health_facility, class: "flex items-center gap-1 text-blue-600 hover:underline text-sm" do %>
          <i class="ph ph-eye"></i> <%= t(".show") %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
