<% content_for :title, "Documentación de la API" %>
<% content_for :description, "Cómo usar la API del Servicio Sacerdotal Nocturno: autenticación, guardias, servicios y ubicaciones, con ejemplos para probar cada llamada." %>
<!DOCTYPE html>
<html lang="es">
  <head>
    <%= render "layouts/seo" %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">
    <%= stylesheet_link_tag "application" %>
    <%# The navbar is h-14 (3.5rem); Scalar keeps its sidebar and sticky header below it. %>
    <style>:root { --scalar-custom-header-height: 3.5rem; }</style>
  </head>

  <body class="min-h-screen bg-white">
    <div class="sticky top-0 z-50">
      <%= render "layouts/doc_navbar" %>
    </div>
    <div id="api-docs"></div>

    <script src="https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.76.0/dist/browser/standalone.js"></script>
    <script>
      <%# Not #api-reference: the standalone script mounts an empty reference on that id by itself. %>
      Scalar.createApiReference("#api-docs", {
        url: "<%= api_spec_path %>",
        hideDarkModeToggle: true,
        forceDarkModeState: "light",
        showDeveloperTools: "never",
        telemetry: false,
        agent: { disabled: true },
        mcp: { disabled: true },
        authentication: { preferredSecurityScheme: "bearerAuth" },
        metaData: { title: "<%= j content_for(:title) %>" }
      })
    </script>
  </body>
</html>
