<% content_for :title, "#{@headquarter.city} · #{t(".title")}" %>

<% full_address = [ @headquarter.address, @headquarter.city, @headquarter.state, @headquarter.country ].compact_blank.join(", ") %>
<% clipboard_text = [
     "#{Headquarter.model_name.human}: #{@headquarter.city}, #{@headquarter.state}, #{@headquarter.country}",
     "#{Headquarter.human_attribute_name(:address)}: https://maps.google.com/?q=#{ERB::Util.url_encode(full_address)}",
     ("#{Headquarter.human_attribute_name(:phone)}: #{@headquarter.phone}" if @headquarter.phone.present?),
     ("#{Headquarter.human_attribute_name(:whatsapp)}: #{@headquarter.whatsapp}" if @headquarter.whatsapp.present?),
     ("#{Headquarter.human_attribute_name(:email)}: #{@headquarter.email}" if @headquarter.email.present?),
     ("#{Headquarter.human_attribute_name(:web_address)}: #{@headquarter.web_address}" if @headquarter.web_address.present?),
     ("#{Headquarter.human_attribute_name(:facebook)}: #{@headquarter.facebook}" if @headquarter.facebook.present?),
     ("#{Headquarter.human_attribute_name(:instagram)}: #{@headquarter.instagram}" if @headquarter.instagram.present?)
   ].compact.join("\n") %>

<div>
  <div class="flex items-center justify-between gap-4 mb-6">
    <%= link_to sedes_path, class: "inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-indigo-600" do %>
      <i class="ph ph-arrow-left"></i> <%= t(".back") %>
    <% end %>
    <button type="button"
            data-controller="clipboard"
            data-clipboard-text-value="<%= clipboard_text %>"
            data-action="click->clipboard#copy"
            class="flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-3 py-1.5 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
      <i class="ph ph-copy" data-clipboard-target="icon"></i> <%= t(".copy") %>
    </button>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8">
    <div class="flex items-center gap-4 mb-6">
      <div class="flex items-center justify-center w-14 h-14 rounded-lg bg-indigo-50 text-indigo-500 shrink-0">
        <i class="ph ph-buildings text-3xl"></i>
      </div>
      <div class="min-w-0">
        <h1 class="text-2xl font-bold text-gray-900 truncate"><%= @headquarter.city %></h1>
        <p class="text-sm text-gray-500 truncate"><%= @headquarter.state %>, <%= @headquarter.country %></p>
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div class="space-y-4">
        <div class="flex items-start gap-3">
          <i class="ph ph-map-pin text-gray-400 shrink-0 mt-0.5 text-lg"></i>
          <div class="min-w-0">
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Headquarter.human_attribute_name(:address) %></p>
            <p class="text-gray-800"><%= @headquarter.address %></p>
          </div>
        </div>
        <% [
             [ "ph-phone", :phone, @headquarter.phone ],
             [ "ph-whatsapp-logo", :whatsapp, @headquarter.whatsapp ],
             [ "ph-envelope-simple", :email, @headquarter.email ]
           ].each do |icon, attr, value| %>
          <% next if value.blank? %>
          <div class="flex items-start gap-3">
            <i class="ph <%= icon %> text-gray-400 shrink-0 mt-0.5 text-lg"></i>
            <div class="min-w-0">
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Headquarter.human_attribute_name(attr) %></p>
              <p class="text-gray-800 break-words"><%= value %></p>
            </div>
          </div>
        <% end %>
        <% links = [
             [ "ph-globe", @headquarter.web_address ],
             [ "ph-facebook-logo", @headquarter.facebook ],
             [ "ph-instagram-logo", @headquarter.instagram ]
           ].reject { |_icon, value| value.blank? } %>
        <% if links.any? %>
          <div class="flex items-center gap-4 pt-3 mt-3 border-t border-gray-100">
            <% links.each do |icon, value| %>
              <% if value.start_with?("http") %>
                <%= link_to value, target: "_blank", rel: "noopener", class: "text-gray-400 hover:text-indigo-600" do %>
                  <i class="ph <%= icon %> text-2xl"></i>
                <% end %>
              <% else %>
                <span class="flex items-center gap-1.5 text-sm text-gray-600 min-w-0" title="<%= value %>">
                  <i class="ph <%= icon %> text-2xl text-gray-400 shrink-0"></i>
                  <span class="truncate"><%= value %></span>
                </span>
              <% end %>
            <% end %>
          </div>
        <% end %>
      </div>

      <div>
        <div class="flex items-center justify-between mb-2">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide flex items-center gap-1.5">
            <i class="ph ph-map-trifold"></i> <%= t(".map") %>
          </p>
          <%= link_to "https://maps.google.com/?q=#{URI.encode_uri_component(full_address)}",
                       target: "_blank", rel: "noopener",
                       class: "text-xs text-indigo-600 hover:underline flex items-center gap-1" do %>
            <i class="ph ph-arrow-square-out"></i> <%= t(".open_in_maps") %>
          <% end %>
        </div>
        <div data-controller="address-map"
             data-address-map-target="map"
             data-address-map-initial-address-value="<%= full_address %>"
             data-address-map-restrict-country-value="false"
             class="w-full h-64 lg:h-full min-h-64 rounded-xl overflow-hidden border border-gray-200 bg-gray-100"></div>
      </div>
    </div>
  </div>
</div>
