<% content_for :title, t(".title") %>

<div data-controller="headquarters-filter">
  <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight text-gray-900 mb-4"><%= t(".title") %></h1>
  <p class="text-base sm:text-lg text-gray-500 leading-relaxed max-w-2xl"><%= t(".subtitle") %></p>

  <hr class="border-gray-200 my-8">

  <div data-headquarters-filter-target="filters" class="mb-6 flex flex-wrap items-center gap-3">
    <% facets = {
         country: @headquarters.map(&:country).uniq.sort,
         state: @headquarters.map(&:state).uniq.sort,
         city: @headquarters.map(&:city).uniq.sort
       } %>
    <% facets.each do |facet, values| %>
      <div class="relative">
        <button type="button"
                data-action="click->headquarters-filter#toggle"
                data-headquarters-filter-facet-param="<%= facet %>"
                class="cursor-pointer flex items-center gap-2 rounded-md bg-white border border-gray-200 px-3 py-1.5 text-sm font-medium text-gray-700 hover:bg-gray-50">
          <%= Headquarter.human_attribute_name(facet) %>
          <span data-headquarters-filter-target="badge" data-facet="<%= facet %>"
                class="hidden flex items-center justify-center min-w-5 h-5 px-1 rounded-full bg-indigo-600 text-xs font-semibold text-white"></span>
          <i class="ph ph-caret-down text-xs text-gray-400"></i>
        </button>
        <div data-headquarters-filter-target="panel" data-facet="<%= facet %>"
             class="hidden absolute left-0 top-full mt-2 z-10 w-64 max-h-64 overflow-y-auto bg-white border border-gray-200 rounded-lg shadow-lg py-1">
          <% values.each do |value| %>
            <label class="flex items-center gap-2 px-3 py-2 text-sm text-gray-700 hover:bg-gray-50 cursor-pointer">
              <input type="checkbox"
                     value="<%= value %>"
                     data-headquarters-filter-target="checkbox"
                     data-facet="<%= facet %>"
                     data-action="change->headquarters-filter#select"
                     class="rounded border-gray-300 text-indigo-600 focus:ring-indigo-500">
              <span class="truncate"><%= value %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <button type="button"
            data-action="click->headquarters-filter#clear"
            class="cursor-pointer flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-indigo-600">
      <i class="ph ph-x-circle"></i> <%= t(".clear_filters") %>
    </button>

    <p class="ml-auto text-sm text-gray-500">
      <span data-headquarters-filter-target="count" class="font-semibold text-gray-700"><%= @headquarters.size %></span>
      <%= t(".results_label") %>
    </p>
  </div>

  <div data-headquarters-filter-target="grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% @headquarters.each do |headquarter| %>
      <div data-headquarters-filter-target="card"
           data-country="<%= headquarter.country %>"
           data-state="<%= headquarter.state %>"
           data-city="<%= headquarter.city %>"
           class="bg-white border border-gray-200 rounded-xl p-5">
        <div class="flex items-center gap-3 mb-4">
          <div class="flex items-center justify-center w-10 h-10 rounded-lg bg-indigo-50 text-indigo-500 shrink-0">
            <i class="ph ph-buildings text-xl"></i>
          </div>
          <div class="min-w-0">
            <button type="button"
                    data-action="click->headquarters-filter#expand"
                    data-headquarters-filter-headquarter-id-param="<%= headquarter.id %>"
                    class="cursor-pointer font-bold text-gray-900 hover:text-indigo-600 truncate block text-left">
              <%= headquarter.city %>
            </button>
            <p class="text-xs text-gray-500 truncate"><%= headquarter.state %>, <%= headquarter.country %></p>
          </div>
        </div>
        <div class="space-y-2">
          <div class="flex items-start gap-2">
            <i class="ph ph-map-pin text-gray-400 shrink-0 mt-0.5"></i>
            <p class="text-sm text-gray-600"><%= headquarter.address %></p>
          </div>
          <% [
               [ "ph-phone", headquarter.phone ],
               [ "ph-whatsapp-logo", headquarter.whatsapp ],
               [ "ph-envelope-simple", headquarter.email ]
             ].each do |icon, value| %>
            <% next if value.blank? %>
            <div class="flex items-start gap-2">
              <i class="ph <%= icon %> text-gray-400 shrink-0 mt-0.5"></i>
              <p class="text-sm text-gray-600 break-words min-w-0"><%= value %></p>
            </div>
          <% end %>
          <% links = [
               [ "ph-globe", headquarter.web_address ],
               [ "ph-facebook-logo", headquarter.facebook ],
               [ "ph-instagram-logo", headquarter.instagram ]
             ].reject { |_icon, value| value.blank? } %>
          <% if links.any? %>
            <div class="flex items-center gap-3 pt-1 border-t border-gray-100">
              <% links.each do |icon, value| %>
                <% if value.start_with?("http") %>
                  <%= link_to value, target: "_blank", rel: "noopener", class: "text-gray-400 hover:text-indigo-600" do %>
                    <i class="ph <%= icon %> text-lg"></i>
                  <% end %>
                <% else %>
                  <span class="flex items-center gap-1.5 text-sm text-gray-600 min-w-0" title="<%= value %>">
                    <i class="ph <%= icon %> text-lg text-gray-400 shrink-0"></i>
                    <span class="truncate"><%= value %></span>
                  </span>
                <% end %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <div data-headquarters-filter-target="empty" class="hidden text-center py-16">
    <i class="ph ph-magnifying-glass text-4xl text-gray-300"></i>
    <p class="mt-2 text-sm text-gray-500"><%= t(".empty") %></p>
  </div>

  <% @headquarters.each do |headquarter| %>
    <% full_address = [ headquarter.address, headquarter.city, headquarter.state, headquarter.country ].compact_blank.join(", ") %>
    <div data-headquarters-filter-target="detail" data-headquarter-id="<%= headquarter.id %>" class="hidden">
      <button type="button"
              data-action="click->headquarters-filter#collapse"
              class="cursor-pointer inline-flex items-center gap-1.5 text-sm font-medium text-gray-500 hover:text-indigo-600 mb-6">
        <i class="ph ph-arrow-left"></i> <%= t(".back") %>
      </button>

      <div class="bg-white border border-gray-200 rounded-xl p-6 sm:p-8">
        <div class="flex items-center gap-4 mb-6">
          <div class="flex items-center justify-center w-14 h-14 rounded-lg bg-indigo-50 text-indigo-500 shrink-0">
            <i class="ph ph-buildings text-3xl"></i>
          </div>
          <div class="min-w-0">
            <h2 class="text-2xl font-bold text-gray-900 truncate"><%= headquarter.city %></h2>
            <p class="text-sm text-gray-500 truncate"><%= headquarter.state %>, <%= headquarter.country %></p>
          </div>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
          <div class="space-y-4">
            <div class="flex items-start gap-3">
              <i class="ph ph-map-pin text-gray-400 shrink-0 mt-0.5 text-lg"></i>
              <div class="min-w-0">
                <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Headquarter.human_attribute_name(:address) %></p>
                <p class="text-gray-800"><%= headquarter.address %></p>
              </div>
            </div>
            <% [
                 [ "ph-phone", :phone, headquarter.phone ],
                 [ "ph-whatsapp-logo", :whatsapp, headquarter.whatsapp ],
                 [ "ph-envelope-simple", :email, headquarter.email ]
               ].each do |icon, attr, value| %>
              <% next if value.blank? %>
              <div class="flex items-start gap-3">
                <i class="ph <%= icon %> text-gray-400 shrink-0 mt-0.5 text-lg"></i>
                <div class="min-w-0">
                  <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Headquarter.human_attribute_name(attr) %></p>
                  <p class="text-gray-800 break-words"><%= value %></p>
                </div>
              </div>
            <% end %>
            <% links = [
                 [ "ph-globe", headquarter.web_address ],
                 [ "ph-facebook-logo", headquarter.facebook ],
                 [ "ph-instagram-logo", headquarter.instagram ]
               ].reject { |_icon, value| value.blank? } %>
            <% if links.any? %>
              <div class="flex items-center gap-4 pt-3 mt-3 border-t border-gray-100">
                <% links.each do |icon, value| %>
                  <% if value.start_with?("http") %>
                    <%= link_to value, target: "_blank", rel: "noopener", class: "text-gray-400 hover:text-indigo-600" do %>
                      <i class="ph <%= icon %> text-2xl"></i>
                    <% end %>
                  <% else %>
                    <span class="flex items-center gap-1.5 text-sm text-gray-600 min-w-0" title="<%= value %>">
                      <i class="ph <%= icon %> text-2xl text-gray-400 shrink-0"></i>
                      <span class="truncate"><%= value %></span>
                    </span>
                  <% end %>
                <% end %>
              </div>
            <% end %>
          </div>

          <div>
            <div class="flex items-center justify-between mb-2">
              <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide flex items-center gap-1.5">
                <i class="ph ph-map-trifold"></i> <%= t(".map") %>
              </p>
              <%= link_to "https://maps.google.com/?q=#{URI.encode_uri_component(full_address)}",
                           target: "_blank", rel: "noopener",
                           class: "text-xs text-indigo-600 hover:underline flex items-center gap-1" do %>
                <i class="ph ph-arrow-square-out"></i> <%= t(".open_in_maps") %>
              <% end %>
            </div>
            <div data-map-holder
                 data-map-address="<%= full_address %>"
                 class="w-full h-64 lg:h-full min-h-64 rounded-xl overflow-hidden border border-gray-200 bg-gray-100 flex items-center justify-center">
              <div class="flex flex-col items-center gap-2 text-gray-400 text-sm">
                <i class="ph ph-map-trifold text-2xl"></i>
                <%= t(".map_placeholder") %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  <% end %>
</div>
