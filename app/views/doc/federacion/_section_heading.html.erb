<% ids = sections.map(&:first) %>
<% index = ids.index(id) %>
<% neighbors = [
     [ index.positive? ? sections[index - 1] : nil, "ph-caret-up", "Sección anterior" ],
     [ sections[index + 1], "ph-caret-down", "Sección siguiente" ]
   ] %>
<div class="flex items-start justify-between gap-3 mb-5 pb-3 border-b border-gray-200">
  <h2 id="<%= id %>" class="scroll-mt-6 text-2xl font-bold text-gray-900"><%= title %></h2>
  <div class="flex items-center gap-1 shrink-0 mt-1">
    <% neighbors.each do |section, icon, label| %>
      <% if section %>
        <a href="#<%= section.first %>"
           data-action="scroll-spy#jump"
           title="<%= label %>: <%= section.last %>"
           aria-label="<%= label %>: <%= section.last %>"
           class="flex items-center justify-center w-8 h-8 rounded-md border border-gray-200 bg-white text-gray-500 hover:border-indigo-400 hover:bg-indigo-50 hover:text-indigo-700 transition-colors">
          <i class="ph <%= icon %>"></i>
        </a>
      <% else %>
        <span class="flex items-center justify-center w-8 h-8 rounded-md border border-gray-100 text-gray-300" aria-hidden="true">
          <i class="ph <%= icon %>"></i>
        </span>
      <% end %>
    <% end %>
  </div>
</div>
