
<div>
  <%= image_tag "fassnu-logo.svg", alt: "FASSNU", class: "h-32 sm:h-80 w-auto mb-8 mx-auto" %>

  <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight leading-tight text-gray-900 mb-4 text-center"><%= t(".title") %></h1>
  <div class="flex justify-center">
    <p class="inline-flex items-center gap-2 text-center text-base sm:text-lg font-semibold italic text-indigo-700 bg-indigo-50 border border-indigo-100 rounded-full px-5 py-2 max-w-3xl">
      <i class="ph ph-quotes text-indigo-400"></i> <%= t(".theme") %>
    </p>
  </div>

  <div class="mt-6 flex flex-col sm:flex-row gap-3">
    <% calendar_params = {
         action: "TEMPLATE",
         text: t(".title"),
         dates: "20260828/20260831",
         details: t(".theme"),
         location: t(".location")
       } %>
    <%= link_to "https://calendar.google.com/calendar/render?#{calendar_params.to_query}", target: "_blank", rel: "noopener", class: "group w-full sm:flex-1 flex items-center gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3 hover:bg-indigo-50 hover:border-indigo-400 hover:shadow-md transition-all" do %>
      <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-500 shrink-0">
        <i class="ph ph-calendar-blank text-lg"></i>
      </span>
      <i class="ph ph-arrow-right text-2xl text-indigo-600 shrink-0 transition-transform group-hover:translate-x-1"></i>
      <span class="text-sm font-semibold text-gray-700 group-hover:text-indigo-600"><%= t(".dates") %></span>
    <% end %>
    <%= link_to "https://maps.google.com/?q=#{URI.encode_uri_component(t('.location'))}", target: "_blank", rel: "noopener", class: "group w-full sm:flex-1 flex items-center gap-3 bg-white border border-gray-200 rounded-xl px-4 py-3 hover:bg-indigo-50 hover:border-indigo-400 hover:shadow-md transition-all" do %>
      <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-500 shrink-0">
        <i class="ph ph-map-pin text-lg"></i>
      </span>
      <i class="ph ph-arrow-right text-2xl text-indigo-600 shrink-0 transition-transform group-hover:translate-x-1"></i>
      <span class="text-sm font-semibold text-gray-700 group-hover:text-indigo-600"><%= t(".location") %></span>
    <% end %>
  </div>

  <div class="mt-8 flex justify-center">
    <%= link_to "https://forms.gle/XcxyZZ74XtXGQdih8", target: "_blank", rel: "noopener", class: "flex items-center gap-2 px-6 py-3 bg-indigo-600 text-white text-sm font-semibold rounded-md hover:bg-indigo-700 shadow-sm transition-colors" do %>
      <i class="ph ph-note-pencil"></i> <%= t(".fill_form") %>
    <% end %>
  </div>

  <hr class="border-gray-200 my-8">

  <h2 class="text-xl font-bold text-gray-900 mb-6"><%= t(".program") %></h2>

  <div class="space-y-6">
    <% @schedule.each do |day| %>
      <div class="bg-white border border-gray-200 rounded-xl p-5 sm:p-6">
        <h3 class="flex items-center gap-3 font-bold text-gray-900 mb-4">
          <span class="flex items-center justify-center w-9 h-9 rounded-lg bg-indigo-50 text-indigo-500 shrink-0">
            <i class="ph ph-calendar-check text-lg"></i>
          </span>
          <%= day[:label] %>
        </h3>
        <ul class="space-y-3">
          <% day[:items].each do |time, activity| %>
            <li class="flex items-start gap-3">
              <span class="shrink-0 inline-flex items-center justify-center rounded-full bg-indigo-50 text-indigo-600 text-xs font-semibold px-2.5 py-1 min-w-[4.5rem] text-center">
                <%= time %>
              </span>
              <span class="text-sm text-gray-700 pt-0.5"><%= activity %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  </div>
</div>
