<div class="py-8">
  <%= render @guard_setup %>

  <div class="mt-6 flex items-center gap-4">
    <%= link_to t(".edit"), edit_guard_setup_path(@guard_setup), class: "text-blue-600 hover:underline" %>
    <%= link_to t(".back"), guard_setups_path, class: "text-blue-600 hover:underline" %>
    <%= button_to t(".destroy"), @guard_setup, method: :delete, class: "cursor-pointer rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" %>
  </div>
</div>
