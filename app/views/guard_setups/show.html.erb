<div class="py-8 max-w-xl">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to guard_setups_path, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <%= render @guard_setup %>

  <div class="mt-4 flex items-center gap-3">
    <%= link_to t(".edit"), edit_guard_setup_path(@guard_setup), class: "flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
    <%= button_to t(".destroy"), @guard_setup, method: :delete, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" %>
  </div>
</div>
