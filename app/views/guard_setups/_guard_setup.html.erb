<div id="<%= dom_id guard_setup %>" class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">

  <div class="px-6 py-5 border-b border-gray-100 flex items-center justify-between bg-gradient-to-r from-blue-50 to-white">
    <div>
      <p class="text-xs font-medium text-blue-400 uppercase tracking-wide"><%= GuardSetup.human_attribute_name(:day_number) %></p>
      <h2 class="text-2xl font-bold text-gray-900 mt-0.5"># <%= guard_setup.day_number %></h2>
    </div>
    <div class="flex items-center justify-center w-12 h-12 rounded-full bg-blue-100 text-blue-700">
      <i class="ph ph-shield text-xl"></i>
    </div>
  </div>

  <div class="divide-y divide-gray-100">
    <div class="px-6 py-4 flex items-center gap-4">
      <div class="flex items-center justify-center w-8 h-8 rounded-full bg-red-100 text-red-700 shrink-0">
        <i class="ph ph-user"></i>
      </div>
      <div>
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= GuardSetup.human_attribute_name(:vocal) %></p>
        <p class="text-sm font-semibold text-gray-900 mt-0.5"><%= guard_setup.vocal.full_name %></p>
      </div>
    </div>

    <div class="px-6 py-4">
      <div class="flex items-center gap-2 mb-3">
        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-green-100 text-green-700 shrink-0">
          <i class="ph ph-users text-sm"></i>
        </div>
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= GuardSetup.human_attribute_name(:guardians) %></p>
      </div>
      <div class="flex flex-wrap gap-2 pl-10">
        <% guard_setup.guardians.order(:last_name, :first_name).each do |guardian| %>
          <span class="badge_green"><%= guardian.full_name %></span>
        <% end %>
      </div>
    </div>

    <% if guard_setup.notes.present? %>
      <div class="px-6 py-4 flex items-start gap-4">
        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500 shrink-0">
          <i class="ph ph-note text-sm"></i>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= GuardSetup.human_attribute_name(:notes) %></p>
          <p class="text-sm text-gray-700 mt-0.5"><%= guard_setup.notes %></p>
        </div>
      </div>
    <% end %>
  </div>
</div>
