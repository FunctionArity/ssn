<div class="py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <%= link_to t(".new_guard_setup"), new_guard_setup_path, class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>

  <div id="guard_setups" class="space-y-4">
    <% @guard_setups.each do |guard_setup| %>
      <div class="border border-gray-200 rounded-lg p-4 flex items-center justify-between">
        <div>
          <p class="font-semibold"><%= guard_setup.day_number %></p>
          <p class="text-sm text-gray-500">
            <%= GuardSetup.human_attribute_name(:vocal) %>: <%= guard_setup.vocal.first_name %> <%= guard_setup.vocal.last_name %> &middot;
            <%= GuardSetup.human_attribute_name(:priest) %>: <%= guard_setup.priest.first_name %> <%= guard_setup.priest.last_name %> &middot;
            <%= t(".guardians_count", count: guard_setup.guardians.size) %>
          </p>
        </div>
        <div class="flex items-center gap-3">
          <%= link_to new_guard_path(guard_setup_id: guard_setup.id), class: "flex items-center gap-1 text-green-600 hover:underline text-sm" do %>
            <i class="ph ph-plus-circle"></i> <%= t(".create_guard") %>
          <% end %>
          <%= link_to guard_setup, class: "flex items-center gap-1 text-blue-600 hover:underline text-sm" do %>
            <i class="ph ph-eye"></i> <%= t(".show") %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>
</div>
