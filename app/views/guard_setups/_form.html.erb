<%= form_with(model: guard_setup, class: "space-y-6") do |form| %>
  <% if guard_setup.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-800 rounded-lg p-4">
      <h2 class="font-semibold mb-2"><%= t("guard_setups.form.errors.title", count: guard_setup.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% guard_setup.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :day_number, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.number_field :day_number, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :vocal, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.collection_select :vocal_id, User.vocal, :id, ->(u) { "#{u.first_name} #{u.last_name}" }, { prompt: t("guard_setups.form.select_vocal") }, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div data-controller="guardian-setup-search"
       data-guardian-setup-search-guardians-value="<%= User.guardian.map { |u| { id: u.id, name: "#{u.first_name} #{u.last_name}" } }.to_json %>"
       data-guardian-setup-search-selected-value="<%= guard_setup.guardian_ids.to_json %>"
       data-guardian-setup-search-field-name-value="guard_setup[guardian_ids][]">
    <span class="block text-sm font-medium text-gray-700 mb-1"><%= GuardSetup.human_attribute_name(:guardians) %></span>
    <div class="relative">
      <input type="text"
             data-guardian-setup-search-target="input"
             data-action="input->guardian-setup-search#filter"
             placeholder="<%= t('guard_setups.form.search_guardians', default: 'Search guardians...') %>"
             autocomplete="off"
             class="w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
      <div data-guardian-setup-search-target="dropdown"
           class="hidden absolute z-10 mt-1 w-full rounded-md border border-gray-200 bg-white shadow-lg max-h-48 overflow-y-auto"></div>
    </div>
    <div data-guardian-setup-search-target="selectedList" class="flex flex-wrap gap-2 mt-2"></div>
  </div>

  <div>
    <%= form.label :notes, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :notes, rows: 3, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div class="border-t border-gray-100 pt-4 flex justify-end">
    <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors" %>
  </div>
<% end %>
