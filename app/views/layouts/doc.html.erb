<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ssn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">

    <% if Rails.application.credentials.google_maps_api_key.present? %>
      <meta name="google-maps-api-key" content="<%= Rails.application.credentials.google_maps_api_key %>">
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-gray-50">
    <nav class="bg-indigo-950 border-b border-white/10">
      <div class="w-full px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-14 items-center">
          <div class="flex items-center gap-2.5">
            <%= link_to root_path, class: "flex items-center gap-2.5" do %>
              <%= image_tag "icon.svg", class: "h-8 w-8" %>
              <span class="text-white font-bold text-[15px] tracking-tight">SSN</span>
            <% end %>
            <span class="text-white/20 text-xl leading-none">/</span>
            <span class="text-indigo-300 text-sm font-medium"><%= content_for(:title) %></span>
          </div>
          <%= link_to "https://info.serviciosacerdotalnocturno.org", target: "_blank", rel: "noopener noreferrer", class: "flex items-center gap-1.5 text-sm text-indigo-300 hover:text-white font-medium transition-colors" do %>
            <i class="ph ph-info"></i> <%= t("sidebar.documentation") %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <%= yield %>
    </main>
  </body>
</html>
