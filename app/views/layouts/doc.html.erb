<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "layouts/seo" %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">

    <% if Rails.application.credentials.google_maps_api_key.present? %>
      <meta name="google-maps-api-key" content="<%= Rails.application.credentials.google_maps_api_key %>">
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-gray-50">
    <%= render "layouts/doc_navbar" %>
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <%= yield %>
    </main>
    <footer class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pb-10 text-center text-xs text-gray-400">
      <%= link_to t("devise_views.shared.privacy_policy"), privacidad_path, class: "hover:text-gray-600 hover:underline" %>
      <span class="mx-2" aria-hidden="true">·</span>
      <%= link_to t("devise_views.shared.terms"), terminos_path, class: "hover:text-gray-600 hover:underline" %>
      <span class="mx-2" aria-hidden="true">·</span>
      <%= link_to t("devise_views.shared.api_docs"), api_docs_path, class: "hover:text-gray-600 hover:underline" %>
    </footer>
  </body>
</html>
