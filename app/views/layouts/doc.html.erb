<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ssn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="icon" href="/icon.png?v=2" type="image/png">
    <link rel="icon" href="/icon.svg?v=2" type="image/svg+xml">

    <% if Rails.application.credentials.google_maps_api_key.present? %>
      <meta name="google-maps-api-key" content="<%= Rails.application.credentials.google_maps_api_key %>">
    <% end %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-gray-50">
    <main class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14">
      <%= yield %>
    </main>
  </body>
</html>
