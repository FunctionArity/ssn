<aside class="sidebar shrink-0 bg-white border-r border-gray-200 py-6">
  <nav class="space-y-1">
    <%= link_to users_path, class: "sidebar-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium #{request.path.start_with?('/users') ? 'bg-gray-100 text-gray-900' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
      <i class="ph ph-users text-lg"></i>
      <span class="sidebar-label"><%= t("users.index.title") %></span>
    <% end %>
    <%= link_to guards_path, class: "sidebar-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium #{request.path.start_with?('/guards') && !request.path.start_with?('/guard_setups') ? 'bg-gray-100 text-gray-900' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
      <i class="ph ph-shield text-lg"></i>
      <span class="sidebar-label"><%= t("guards.index.title") %></span>
    <% end %>
    <%= link_to guard_setups_path, class: "sidebar-link flex items-center gap-2 rounded-md px-3 py-2 text-sm font-medium #{request.path.start_with?('/guard_setups') ? 'bg-gray-100 text-gray-900' : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900'}" do %>
      <i class="ph ph-gear text-lg"></i>
      <span class="sidebar-label"><%= t("guard_setups.index.title") %></span>
    <% end %>
  </nav>
</aside>
