<aside class="sidebar shrink-0 bg-white border-r border-gray-200 flex flex-col">
  <div class="md:hidden flex items-center justify-between px-4 py-4 border-b border-gray-100 shrink-0">
    <div class="flex items-center gap-2">
      <%= image_tag "icon.svg", class: "h-7 w-7" %>
      <span class="text-sm font-semibold text-gray-700"><%= t("sidebar.menu") %></span>
    </div>
    <button type="button"
            class="cursor-pointer flex items-center justify-center w-8 h-8 rounded-md text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-colors"
            data-action="click->mobile-nav#close">
      <i class="ph ph-x text-lg"></i>
    </button>
  </div>

  <nav class="space-y-1 py-6 flex-1 overflow-y-auto">
    <% guards_active = request.path.start_with?('/guards') && !request.path.start_with?('/guard_setups') %>
    <%= link_to guards_path, class: "sidebar-link flex items-center gap-2 rounded-r-md px-3 py-2 text-sm font-medium border-l-2 #{guards_active ? 'bg-blue-50 text-blue-700 border-blue-600' : 'text-gray-600 border-transparent hover:bg-gray-50 hover:text-gray-900'}" do %>
      <i class="ph ph-shield text-lg"></i>
      <span class="sidebar-label"><%= t("guards.index.title") %></span>
    <% end %>
    <% services_active = request.path.start_with?('/services') %>
    <%= link_to services_path, class: "sidebar-link flex items-center gap-2 rounded-r-md px-3 py-2 text-sm font-medium border-l-2 #{services_active ? 'bg-blue-50 text-blue-700 border-blue-600' : 'text-gray-600 border-transparent hover:bg-gray-50 hover:text-gray-900'}" do %>
      <i class="ph ph-hand-heart text-lg"></i>
      <span class="sidebar-label"><%= t("services.index.title") %></span>
    <% end %>
    <details class="group mx-2 rounded-lg border border-gray-100 bg-gray-50 overflow-hidden" data-controller="disclosure" <%= 'open' if setup_active? %>>
      <summary data-action="click->disclosure#toggle" class="sidebar-link flex items-center gap-2 px-3 py-2 text-sm font-medium text-gray-600 hover:bg-gray-100 hover:text-gray-900 cursor-pointer list-none select-none">
        <i class="ph ph-sliders text-lg"></i>
        <span class="sidebar-label"><%= t("sidebar.setup") %></span>
        <i class="ph ph-caret-right text-xs ml-auto transition-transform duration-300 group-open:rotate-90"></i>
      </summary>
      <div data-disclosure-target="content" class="overflow-hidden border-t border-gray-100 divide-y divide-gray-100">
        <%= link_to users_path, class: "sidebar-link flex items-center gap-2 px-3 py-2 text-sm font-medium border-l-2 border-b-0 #{request.path.start_with?('/users') ? 'text-blue-700 border-blue-600 border-t-transparent' : 'text-gray-600 border-transparent hover:bg-gray-100 hover:text-gray-900'}" do %>
          <i class="ph ph-users text-lg"></i>
          <span class="sidebar-label"><%= t("users.index.title") %></span>
        <% end %>
        <%= link_to guard_setups_path, class: "sidebar-link flex items-center gap-2 px-3 py-2 text-sm font-medium border-l-2 border-b-0 #{request.path.start_with?('/guard_setups') ? 'text-blue-700 border-blue-600 border-t-transparent' : 'text-gray-600 border-transparent hover:bg-gray-100 hover:text-gray-900'}" do %>
          <i class="ph ph-gear text-lg"></i>
          <span class="sidebar-label"><%= t("guard_setups.index.menu_title") %></span>
        <% end %>
        <%= link_to priest_setups_path, class: "sidebar-link flex items-center gap-2 px-3 py-2 text-sm font-medium border-l-2 border-b-0 #{request.path.start_with?('/priest_setups') ? 'text-blue-700 border-blue-600 border-t-transparent' : 'text-gray-600 border-transparent hover:bg-gray-100 hover:text-gray-900'}" do %>
          <i class="ph ph-calendar text-lg"></i>
          <span class="sidebar-label"><%= t("priest_setups.title") %></span>
        <% end %>
        <%= link_to health_facilities_path, class: "sidebar-link flex items-center gap-2 px-3 py-2 text-sm font-medium border-l-2 border-b-0 #{request.path.start_with?('/health_facilities') ? 'text-blue-700 border-blue-600 border-t-transparent' : 'text-gray-600 border-transparent hover:bg-gray-100 hover:text-gray-900'}" do %>
          <i class="ph ph-hospital text-lg"></i>
          <span class="sidebar-label"><%= t("health_facilities.index.title") %></span>
        <% end %>
        <%= link_to churches_path, class: "sidebar-link flex items-center gap-2 px-3 py-2 text-sm font-medium border-l-2 border-b-0 #{request.path.start_with?('/churches') ? 'text-blue-700 border-blue-600 border-t-transparent' : 'text-gray-600 border-transparent hover:bg-gray-100 hover:text-gray-900'}" do %>
          <i class="ph ph-church text-lg"></i>
          <span class="sidebar-label"><%= t("churches.index.title") %></span>
        <% end %>
        <%= link_to headquarters_path, class: "sidebar-link flex items-center gap-2 px-3 py-2 text-sm font-medium border-l-2 border-b-0 #{request.path.start_with?('/headquarters') ? 'text-blue-700 border-blue-600 border-t-transparent' : 'text-gray-600 border-transparent hover:bg-gray-100 hover:text-gray-900'}" do %>
          <i class="ph ph-buildings text-lg"></i>
          <span class="sidebar-label"><%= t("headquarters.index.title") %></span>
        <% end %>
      </div>
    </details>
    <%= link_to "https://info.serviciosacerdotalnocturno.org", target: "_blank", rel: "noopener noreferrer", class: "sidebar-link flex items-center gap-2 rounded-r-md px-3 py-2 text-sm font-medium border-l-2 text-gray-600 border-transparent hover:bg-gray-50 hover:text-gray-900" do %>
      <i class="ph ph-info text-lg"></i>
      <span class="sidebar-label"><%= t("sidebar.documentation") %></span>
      <i class="ph ph-arrow-square-out text-xs ml-auto text-gray-400"></i>
    <% end %>
  </nav>

  <div class="md:hidden flex items-center gap-3 px-4 py-3 border-t border-gray-100 shrink-0">
    <div class="flex items-center justify-center w-9 h-9 rounded-full bg-indigo-100 text-indigo-700 shrink-0">
      <i class="ph ph-user text-base"></i>
    </div>
    <div class="min-w-0 flex-1">
      <p class="text-sm font-semibold text-gray-900 truncate"><%= current_user.full_name %></p>
      <p class="text-xs text-gray-400"><%= t("activerecord.attributes.user.roles.#{current_user.role}") %></p>
    </div>
    <%= button_to destroy_user_session_path, method: :delete, class: "cursor-pointer flex items-center justify-center w-8 h-8 rounded-md text-gray-400 hover:bg-red-50 hover:text-red-500 transition-colors shrink-0" do %>
      <i class="ph ph-sign-out text-lg"></i>
    <% end %>
  </div>
</aside>
