<div id="confirm-dialog" class="hidden fixed inset-0 z-50 items-center justify-center bg-black/50">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4 overflow-hidden">
    <div class="px-6 pt-6 pb-4 flex items-center gap-3 border-b border-gray-200">
      <div id="confirm-dialog-icon" class="flex items-center justify-center w-10 h-10 rounded-full shrink-0 bg-red-100 text-red-600">
        <i id="confirm-dialog-icon-glyph" class="ph ph-warning text-lg"></i>
      </div>
      <h3 id="confirm-dialog-title" class="text-base font-semibold text-gray-900">Confirmar acción</h3>
    </div>
    <p id="confirm-dialog-message" class="px-6 py-6 text-sm text-gray-600"></p>
    <div class="px-6 py-4 bg-gray-50 flex justify-end gap-3">
      <button id="confirm-dialog-cancel"
              class="cursor-pointer rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-medium uppercase text-gray-700 shadow-sm hover:bg-gray-50">
        Cancelar
      </button>
      <button id="confirm-dialog-confirm"
              class="cursor-pointer rounded-lg px-4 py-2 text-sm font-semibold uppercase text-white shadow-sm bg-red-600 hover:bg-red-500">
        Aceptar
      </button>
    </div>
  </div>
</div>
