<nav class="bg-white border-b border-gray-200">
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-14 items-center">
      <div class="flex items-center gap-3">
        <% if user_signed_in? %>
          <button class="md:hidden flex items-center justify-center w-8 h-8 rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-700 transition-colors"
                  data-action="click->mobile-nav#toggle">
            <i class="ph ph-list text-xl"></i>
          </button>
        <% end %>
        <%= link_to root_path, class: (user_signed_in? ? "navbar-logo-link md:hidden" : nil) do %>
          <%= image_tag "icon.svg", class: "h-8 w-8" %>
        <% end %>
      </div>
      <div class="flex items-center gap-2 sm:gap-4 text-sm min-w-0">
        <% if user_signed_in? && !acting_as_self? %>
            <%= button_to stop_impersonating_path, method: :post, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-violet-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-violet-500 shrink-0" do %>
              <i class="ph ph-detective text-lg shrink-0"></i>
              <span class="hidden sm:inline"><%= t("users.impersonation.banner", name: current_user.full_name) %></span>
            <% end %>
        <% end %>

        <% if user_signed_in? %>
          <%= turbo_stream_from current_user, :mentions %>
          <%= render "layouts/mentions_indicator", user: current_user %>
          <%# The user's picture, or their role icon when they have none or it fails to load. Admins and super admins
             get a colored ring around it. %>
          <% role_icon = capture do %>
            <i class="ph <%= current_user.role_icon_class %> <%= current_user.role_icon_color_class %>"></i>
          <% end %>
          <% picture_title = [ t("activerecord.attributes.user.roles.#{current_user.role}"),
                               (t("activerecord.attributes.user.user_types.#{current_user.user_type}") unless current_user.regular?) ].compact.join(" · ") %>
          <div id="navbar_user_picture" title="<%= picture_title %>" class="shrink-0 rounded-full <%= user_type_ring_class(current_user) %>">
            <% if current_user.avatar.attached? %>
              <div data-controller="avatar-fallback">
                <%= image_tag url_for(current_user.avatar), alt: "", id: "navbar_avatar", class: "block w-7 h-7 rounded-full object-cover",
                      data: { avatar_fallback_target: "image", action: "error->avatar-fallback#fallback" } %>
                <div data-avatar-fallback-target="placeholder" class="hidden items-center justify-center w-7 h-7 rounded-full bg-gray-100"><%= role_icon %></div>
              </div>
            <% else %>
              <div class="flex items-center justify-center w-7 h-7 rounded-full bg-gray-100"><%= role_icon %></div>
            <% end %>
          </div>
          <%= link_to current_user.full_name, user_path(current_user), class: "text-gray-600 truncate min-w-0 max-w-[110px] sm:max-w-none" %>

          <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center gap-1 text-blue-600 hover:text-blue-800 font-medium cursor-pointer shrink-0" do %>
            <i class="ph ph-sign-out"></i>
          <% end %>
        <% else %>
          <%= link_to t("devise.sessions.sign_in"), new_user_session_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
