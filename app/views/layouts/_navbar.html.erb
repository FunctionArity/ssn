<nav class="bg-white border-b border-gray-200">
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-14 items-center">
      <div class="flex items-center gap-6">
        <span class="text-lg font-semibold text-gray-900">SSN</span>
        <% if user_signed_in? %>
          <%= link_to t("users.index.title"), users_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
          <%= link_to t("guards.index.title"), guards_path, class: "text-sm text-gray-600 hover:text-gray-900" %>
        <% end %>
      </div>
      <div class="flex items-center gap-4 text-sm">
        <% if user_signed_in? %>
          <span class="text-gray-600"><%= current_user.email %></span>
          <%= button_to t("devise.sessions.sign_out"), destroy_user_session_path, method: :delete, class: "text-blue-600 hover:text-blue-800 font-medium cursor-pointer" %>
        <% else %>
          <%= link_to t("devise.sessions.sign_in"), new_user_session_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
