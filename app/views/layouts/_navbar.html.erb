<nav class="bg-white border-b border-gray-200">
  <div class="w-full px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between h-14 items-center">
      <div class="flex items-center gap-3">
        <% if user_signed_in? %>
          <button class="md:hidden flex items-center justify-center w-8 h-8 rounded-md text-gray-500 hover:bg-gray-100 hover:text-gray-700 transition-colors"
                  data-action="click->mobile-nav#toggle">
            <i class="ph ph-list text-xl"></i>
          </button>
        <% end %>
        <%= link_to root_path do %>
          <%= image_tag "icon.svg", class: "h-8 w-8" %>
        <% end %>
      </div>
      <div class="flex items-center gap-4 text-sm">
        <% if user_signed_in? && current_user != true_user %>
            <%= button_to stop_impersonating_path, method: :post, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-violet-600 px-3 py-1.5 text-xs font-semibold text-white shadow-sm hover:bg-violet-500" do %>
              <i class="ph ph-detective text-lg shrink-0"></i>
              <%= t("users.impersonation.banner", name: current_user.full_name) %>
            <% end %>
        <% end %>

        <% if user_signed_in? %>
          <%= user_crown_icon %>
          <i class="ph <%= current_user.role_icon_class %> <%= current_user.role_icon_color_class %>"
             title="<%= t("activerecord.attributes.user.roles.#{current_user.role}") %>"></i>
          <span class="text-gray-600"><%= link_to current_user.full_name, user_path(current_user) %></span>

          <%= button_to destroy_user_session_path, method: :delete, class: "flex items-center gap-1 text-blue-600 hover:text-blue-800 font-medium cursor-pointer" do %>
            <i class="ph ph-sign-out"></i>
          <% end %>
        <% else %>
          <%= link_to t("devise.sessions.sign_in"), new_user_session_path, class: "text-blue-600 hover:text-blue-800 font-medium" %>
        <% end %>
      </div>
    </div>
  </div>
</nav>
