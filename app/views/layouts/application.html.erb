<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Ssn" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>
    <% if Rails.application.credentials.google_maps_api_key.present? %>
      <meta name="google-maps-api-key" content="<%= Rails.application.credentials.google_maps_api_key %>">
    <% end %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag "application", "data-turbo-track": "reload", type: "module" %>
  </head>

  <body class="min-h-screen bg-gray-50">
    <%# Custom confirm dialog %>
    <%= render "layouts/confirm_dialog" %>
    <% no_chrome = !user_signed_in? && controller_name.in?(%w[home sessions registrations passwords confirmations unlocks invitations]) %>
    <% unless no_chrome %>
      <%= render "layouts/navbar" %>
    <% end %>

    <div class="flex" style="min-height: <%= no_chrome ? '100vh' : 'calc(100vh - 3.5rem)' %>;">
      <% if user_signed_in? %>
        <%= render "layouts/sidebar" %>
      <% end %>

      <main class="<%= user_signed_in? ? 'flex-1' : 'w-full' %> min-w-0 <%= no_chrome ? 'p-0' : 'px-6 py-6' %> overflow-auto">
        <% unless no_chrome %>
          <% if notice.present? %>
            <div class="mb-4 flex items-center gap-3 px-4 py-3 bg-green-50 border border-green-200 text-green-800 rounded-md shadow-sm">
              <i class="ph ph-check-circle text-lg text-green-500 shrink-0"></i>
              <p class="text-sm font-medium"><%= notice %></p>
            </div>
          <% end %>
          <% if alert.present? && !(controller_name == "sessions" && action_name == "new") %>
            <div class="mb-4 flex items-center gap-3 px-4 py-3 bg-red-50 border border-red-200 text-red-800 rounded-md shadow-sm">
              <i class="ph ph-warning-circle text-lg text-red-500 shrink-0"></i>
              <p class="text-sm font-medium"><%= alert %></p>
            </div>
          <% end %>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
