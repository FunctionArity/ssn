<section class="<%= "mb-8" if filters.any? %>" aria-live="polite">
  <div data-services-search-target="spinner" class="hidden py-10 text-center text-gray-400">
    <i class="ph ph-spinner text-3xl animate-spin"></i>
    <span class="sr-only"><%= t(".loading") %></span>
  </div>

  <div data-services-search-target="results">
    <% if filters.any? %>
      <div class="flex items-center gap-4 mb-4 px-5 py-4 bg-white rounded-2xl border border-gray-200 shadow-sm">
        <div class="flex items-center justify-center w-10 h-10 rounded-md shadow-sm bg-sky-100 text-sky-700 shrink-0">
          <i class="ph ph-magnifying-glass text-xl"></i>
        </div>
        <div class="min-w-0 flex-1">
          <h2 class="text-lg font-bold text-gray-900 leading-tight"><%= t(".title") %></h2>
        </div>
        <div class="text-right shrink-0">
          <p class="text-2xl font-bold text-sky-600 leading-none"><%= results_count %></p>
          <p class="text-xs text-gray-400"><%= t("guards.index.services_count", count: results_count) %></p>
        </div>
      </div>

      <% if results.empty? %>
        <p class="text-center text-sm text-gray-500 py-6"><%= t(".no_results") %></p>
      <% else %>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% results.each do |service| %>
            <%= render partial: "small_view", locals: { service: service, sortable: false } %>
          <% end %>
        </div>
      <% end %>

      <% if total_pages > 1 %>
        <nav class="mt-4 flex items-center justify-between" aria-label="<%= t(".pagination") %>">
          <% link_class = "flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-800" %>
          <% if page > 1 %>
            <%= link_to services_path(filters.merge(page: page - 1)), data: { turbo_frame: "services_results" }, class: link_class do %>
              <i class="ph ph-arrow-left"></i> <%= t(".previous_page") %>
            <% end %>
          <% else %>
            <span></span>
          <% end %>
          <span class="text-sm text-gray-500"><%= t(".page_of", page: page, total: total_pages) %></span>
          <% if page < total_pages %>
            <%= link_to services_path(filters.merge(page: page + 1)), data: { turbo_frame: "services_results" }, class: link_class do %>
              <%= t(".next_page") %> <i class="ph ph-arrow-right"></i>
            <% end %>
          <% else %>
            <span></span>
          <% end %>
        </nav>
      <% end %>
    <% end %>
  </div>
</section>
