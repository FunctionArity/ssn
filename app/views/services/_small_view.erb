<%= turbo_frame_tag dom_id(service) do %>
  <%= link_to service, data: { turbo_frame: "_top" }, class: "sm:hidden flex items-center gap-3 px-4 py-3 bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-200" do %>
    <div class="w-2 h-2 rounded-full shrink-0 <%= service.pending? ? "bg-red-500" : "bg-green-500" %>"></div>
    <div class="min-w-0 flex-1">
      <p class="text-sm font-semibold text-gray-900 truncate"><%= service.full_name %></p>
      <p class="text-xs text-gray-500 truncate"><%= l(service.due_date, format: :long) %></p>
      <% if service.health_facility.present? %>
        <p class="text-xs text-teal-600 truncate flex items-center gap-1">
          <i class="ph ph-hospital text-xs shrink-0"></i> <%= service.health_facility.name %>
        </p>
      <% elsif service.address.present? %>
        <p class="text-xs text-gray-500 truncate flex items-center gap-1">
          <i class="ph ph-map-pin text-xs shrink-0"></i> <%= service.address %>
        </p>
      <% end %>
    </div>
    <span class="<%= service.pending? ? "badge_red" : "badge_green" %> shrink-0"><%= t("services.status.#{service.status}") %></span>
  <% end %>

  <div class="hidden sm:flex bg-white border border-gray-200 rounded-xl shadow-sm hover:shadow-md transition-all duration-200 hover:-translate-y-0.5 overflow-hidden flex-col">

    <% header_class = service.pending? ? "bg-gradient-to-r from-red-100 to-white" : "bg-gradient-to-r from-green-100 to-white" %>
    <% date_class   = service.pending? ? "text-red-500" : "text-green-600" %>
    <% icon_class   = service.pending? ? "bg-red-200 text-red-700" : "bg-green-200 text-green-700" %>
    <div class="px-5 py-4 flex items-center justify-between <%= header_class %> border-b border-gray-100">
      <div class="min-w-0 pr-3">
        <p class="text-xs font-medium <%= date_class %> uppercase tracking-wide"><%= l(service.due_date, format: :long) %></p>
        <p class="text-base font-bold text-gray-900 truncate mt-0.5"><%= service.full_name %></p>
      </div>
      <div class="flex flex-col items-end gap-2 shrink-0">
        <% status_class = service.pending? ? "badge_red" : "badge_green" %>
        <span class="<%= status_class %>"><%= t("services.status.#{service.status}") %></span>
        <div class="flex items-center justify-center w-8 h-8 rounded-full <%= icon_class %>">
          <i class="ph ph-hand-heart text-sm"></i>
        </div>
      </div>
    </div>

    <div class="px-5 py-4 flex flex-col gap-3 grow">
      <div class="flex items-center gap-2">
        <div class="flex items-center justify-center w-7 h-7 rounded-full bg-indigo-100 text-indigo-600 shrink-0">
          <i class="ph ph-shield text-xs"></i>
        </div>
        <div class="min-w-0">
          <p class="text-xs text-gray-400"><%= Service.human_attribute_name(:guard) %></p>
          <p class="text-sm font-medium text-gray-900">
            <%= link_to "Guardia ##{service.guard.day_number}", service.guard, class: "text-indigo-600 hover:underline", data: { turbo_frame: "_top" } %>
          </p>
        </div>
      </div>

      <% if service.health_facility.present? %>
        <div class="flex items-center gap-2">
          <div class="flex items-center justify-center w-7 h-7 rounded-full bg-teal-100 text-teal-600 shrink-0">
            <i class="ph ph-hospital text-xs"></i>
          </div>
          <div class="min-w-0">
            <p class="text-xs text-gray-400"><%= Service.human_attribute_name(:health_facility) %></p>
            <% hf_address = service.health_facility.address.presence || service.health_facility.name %>
            <%= link_to service.health_facility.name, "https://maps.google.com/?q=#{URI.encode_uri_component(hf_address)}", target: "_blank", rel: "noopener", class: "text-sm font-medium text-indigo-600 hover:underline truncate block" %>
          </div>
        </div>
      <% elsif service.address.present? %>
        <div class="flex items-center gap-2">
          <div class="flex items-center justify-center w-7 h-7 rounded-full bg-gray-100 text-gray-500 shrink-0">
            <i class="ph ph-map-pin text-xs"></i>
          </div>
          <div class="min-w-0">
            <p class="text-xs text-gray-400"><%= Service.human_attribute_name(:address) %></p>
            <%= link_to service.address, "https://maps.google.com/?q=#{URI.encode_uri_component(service.address)}", target: "_blank", rel: "noopener", class: "text-sm font-medium text-indigo-600 hover:underline truncate block" %>
          </div>
        </div>
      <% end %>

      <% if service.pathology.present? %>
        <div class="flex items-center gap-2">
          <div class="flex items-center justify-center w-7 h-7 rounded-full bg-orange-100 text-orange-600 shrink-0">
            <i class="ph ph-heartbeat text-xs"></i>
          </div>
          <div class="min-w-0">
            <p class="text-xs text-gray-400"><%= Service.human_attribute_name(:pathology) %></p>
            <p class="text-sm text-gray-700 truncate"><%= service.pathology %></p>
          </div>
        </div>
      <% end %>
    </div>

    <div class="px-5 py-3 border-t border-gray-100 flex items-center justify-between">
      <% if service.pending? %>
        <%= button_to complete_service_path(service), method: :post, form: { data: { turbo_confirm: t("services.show.complete_confirm") } }, class: "cursor-pointer flex items-center gap-1 text-sm font-medium text-red-500 hover:text-red-700" do %>
          <i class="ph ph-check-circle"></i> <%= t("services.show.complete") %>
        <% end %>
      <% else %>
        <span></span>
      <% end %>
      <%= link_to service, class: "flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-800", data: { turbo_frame: "_top" } do %>
        <i class="ph ph-arrow-right"></i> <%= t(".show") %>
      <% end %>
    </div>

  </div>
<% end %>
