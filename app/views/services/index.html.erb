<div data-controller="services-search"
     data-action="turbo:before-fetch-request->services-search#showSpinner turbo:fetch-request-error->services-search#hideSpinner">
  <%# Hidden on first load, but active filters stay visible, e.g. after a reload or from a shared link. %>
  <% filters_open = @filters.any? %>
  <% filters_label = filters_open ? t(".hide_filters") : t(".show_filters") %>
  <% filters_button = capture do %>
    <button type="button"
            data-services-search-target="toggle"
            data-action="services-search#toggleFilters"
            data-show-label="<%= t(".show_filters") %>"
            data-hide-label="<%= t(".hide_filters") %>"
            aria-expanded="<%= filters_open %>"
            aria-label="<%= filters_label %>"
            title="<%= filters_label %>"
            class="group cursor-pointer flex items-center justify-center w-10 h-10 rounded-md border border-gray-300 bg-white text-gray-700 shadow-sm hover:bg-gray-50 transition-colors">
      <i class="ph ph-funnel text-lg group-aria-expanded:hidden"></i>
      <i class="ph ph-funnel-x text-lg hidden group-aria-expanded:inline"></i>
    </button>
  <% end %>

  <%= render "shared/page_header",
        title: t(".title"),
        icon: "ph-hand-heart",
        icon_class: "bg-sky-100 text-sky-700",
        action_label: t(".new_service"),
        action_path: new_service_path,
        extra_action: filters_button %>

  <%= turbo_stream_from "services" %>

  <div>
    <%# flow-root keeps the form's bottom margin inside the height that gets animated. %>
    <%= tag.div data: { services_search_target: "filters" }, class: "flow-root", hidden: !filters_open do %>
      <%= render "search_form", filters: @filters %>
    <% end %>

    <%= turbo_frame_tag "services_results", target: "_top", data: { turbo_action: "advance", services_search_target: "frame" } do %>
      <%= render "search_results", filters: @filters, results: @results, results_count: @results_count, page: @page, total_pages: @total_pages %>

      <%# While searching, services from this guard are listed with the results instead. %>
      <%= tag.div data: { services_search_target: "guard" }, class: "flow-root" do %>
        <% if @current_guard %>
          <div class="mb-6 bg-gradient-to-r from-indigo-50 to-white border border-indigo-100 rounded-xl overflow-hidden">
            <div class="px-4 py-3 border-b border-indigo-100 flex items-center gap-2">
              <div class="flex items-center justify-center w-7 h-7 rounded-full bg-indigo-100 text-indigo-700">
                <i class="ph ph-calendar-check text-sm"></i>
              </div>
              <span class="text-xs font-semibold text-indigo-600 uppercase tracking-wide"><%= t(".current_guard") %>: <%= l(@current_guard.due_date, format: :long) %></span>

              <span class="flex items-center gap-1 text-xs text-gray-400">
                <i class="ph ph-hand-heart"></i> <%= @services.size %> <%= t("guards.index.services_count", count: @services.size) %>
              </span>
              <span class="ml-auto text-xs font-bold text-indigo-400"># <%= @current_guard.day_number %></span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 divide-y sm:divide-y-0 sm:divide-x divide-indigo-100">
              <div class="px-4 py-3 flex items-center gap-3">
                <div class="flex items-center justify-center w-7 h-7 rounded-full bg-purple-100 text-purple-600 shrink-0">
                  <i class="ph ph-cross text-xs"></i>
                </div>
                <div>
                  <p class="text-xs text-gray-400"><%= Guard.human_attribute_name(:priest) %></p>
                  <p class="text-sm font-semibold text-gray-800"><%= @current_guard.priest.full_name %></p>
                </div>
              </div>
              <div class="px-4 py-3 flex items-center gap-3">
                <div class="flex items-center justify-center w-7 h-7 rounded-full bg-red-100 text-red-600 shrink-0">
                  <i class="ph ph-user text-xs"></i>
                </div>
                <div>
                  <p class="text-xs text-gray-400"><%= Guard.human_attribute_name(:vocal) %></p>
                  <p class="text-sm font-semibold text-gray-800"><%= @current_guard.vocal.full_name %></p>
                </div>
              </div>
            </div>
            <div class="px-4 py-3 border-t border-indigo-100 flex items-center justify-end">
              <%= link_to @current_guard, class: "flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-800" do %>
                <i class="ph ph-arrow-right"></i> <%= t(".view_guard") %>
              <% end %>
            </div>
          </div>
        <% end %>

        <%= render "services_grid", services: @services %>
      <% end if @filters.empty? %>

      <% if @pending_other_services.any? %>
        <div class="mt-8">
          <div class="flex items-center gap-4 mb-4 px-5 py-4 bg-white rounded-2xl border border-gray-200 shadow-sm">
            <div class="flex items-center justify-center w-10 h-10 rounded-md shadow-sm bg-amber-100 text-amber-700 shrink-0">
              <i class="ph ph-warning text-xl"></i>
            </div>
            <div class="min-w-0 flex-1">
              <h2 class="text-lg font-bold text-gray-900 leading-tight"><%= t(".pending_from_other_guards") %></h2>
              <p class="text-sm text-gray-500"><%= t(".pending_from_other_guards_hint") %></p>
            </div>
            <div class="text-right shrink-0">
              <p class="text-2xl font-bold text-amber-600 leading-none"><%= @pending_other_services.size %></p>
              <p class="text-xs text-gray-400"><%= t("guards.index.services_count", count: @pending_other_services.size) %></p>
            </div>
          </div>

          <div class="space-y-4">
            <% @pending_other_services.group_by(&:guard).each do |guard, services| %>
              <section class="bg-gradient-to-r from-amber-50 to-white border border-amber-200 rounded-xl overflow-hidden">
                <div class="px-4 py-3 border-b border-amber-200 flex flex-wrap items-center gap-x-3 gap-y-2">
                  <div class="flex items-center justify-center w-7 h-7 rounded-full bg-amber-100 text-amber-700 shrink-0">
                    <i class="ph ph-calendar-x text-sm"></i>
                  </div>
                  <span class="text-sm font-semibold text-gray-900"><%= Guard.model_name.human %> #<%= guard.day_number %></span>
                  <span class="text-sm text-gray-500"><%= l(guard.due_date, format: :long) %></span>
                  <span class="<%= guard.open? ? "badge_green" : "badge_red" %>"><%= t("guards.status.#{guard.status}") %></span>
                  <span class="flex items-center gap-1 text-xs text-gray-500">
                    <i class="ph ph-hand-heart"></i> <%= services.size %> <%= t("guards.index.services_count", count: services.size) %>
                  </span>
                  <%= link_to guard, class: "ml-auto flex items-center gap-1 text-sm font-medium text-blue-600 hover:text-blue-800" do %>
                    <i class="ph ph-arrow-right"></i> <%= t(".view_guard") %>
                  <% end %>
                </div>
                <div class="p-4 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
                  <% services.each do |service| %>
                    <%= render partial: "small_view", locals: { service: service, sortable: false } %>
                  <% end %>
                </div>
              </section>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
