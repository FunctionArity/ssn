<div class="py-8">
  <div class="flex items-center justify-between mb-6">
    <%= link_to services_path, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <%# One popover for the mentions in the service's note and in its conversation: the page can only have one. %>
  <%= render layout: "shared/mention_card" do %>
    <%= render @service %>

    <%= render "comments/thread", commentable: @service, comments: @comments, unread_comment_ids: @unread_comment_ids %>
  <% end %>
</div>
