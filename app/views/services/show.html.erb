<div class="py-8">
  <%= render @service %>

  <div class="mt-6 flex items-center gap-4">
    <%= link_to t(".edit"), edit_service_path(@service), class: "text-blue-600 hover:underline" %>
    <%= link_to t(".back"), services_path, class: "text-blue-600 hover:underline" %>
    <%= button_to t(".destroy"), @service, method: :delete, class: "cursor-pointer rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" %>
  </div>
</div>
