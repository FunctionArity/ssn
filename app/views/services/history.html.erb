<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to @service, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 flex items-center gap-4 bg-gradient-to-r from-gray-100 to-white border-b border-gray-100">
      <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-gray-200 text-gray-700 shrink-0">
        <i class="ph ph-clock-counter-clockwise text-xl"></i>
      </div>
      <div class="min-w-0">
        <h1 class="text-xl font-bold text-gray-900"><%= t(".title") %></h1>
        <p class="text-sm text-gray-500 truncate"><%= @service.full_name %><%= " · NRO #{@service.nro}" if @service.nro.present? %></p>
      </div>
    </div>

    <% if @versions.empty? %>
      <p class="px-6 py-10 text-center text-sm text-gray-400"><%= t(".empty") %></p>
    <% else %>
      <ol class="divide-y divide-gray-100">
        <% @versions.each do |version| %>
          <% event_class = { "create" => "badge_green", "update" => "badge_blue", "destroy" => "badge_red" }.fetch(version.event, "badge_blue") %>
          <% author = @authors[version.whodunnit] %>
          <% changes = service_version_changes(version) %>
          <li id="<%= dom_id(version) %>" class="px-6 py-5">
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="<%= event_class %>"><%= t(".events.#{version.event}", default: version.event) %></span>
              <span class="flex items-center gap-1.5 text-sm font-medium text-gray-900">
                <i class="ph ph-user text-gray-400"></i> <%= author&.full_name || t(".unknown_author") %>
              </span>
              <time datetime="<%= version.created_at.iso8601 %>" class="flex items-center gap-1.5 text-sm text-gray-500 sm:ml-auto">
                <i class="ph ph-clock text-gray-400"></i> <%= l(version.created_at, format: :long) %>
              </time>
            </div>

            <% if changes.empty? %>
              <p class="mt-3 text-sm text-gray-400"><%= t(".no_changes") %></p>
            <% else %>
              <div class="mt-3 overflow-x-auto rounded-lg border border-gray-200">
                <table class="w-full text-sm">
                  <thead class="bg-gray-50 text-xs font-semibold uppercase tracking-wide text-gray-500">
                    <tr>
                      <th class="px-3 py-2 text-left w-1/4"><%= t(".field") %></th>
                      <th class="px-3 py-2 text-left"><%= t(".before") %></th>
                      <th class="px-3 py-2 text-left"><%= t(".after") %></th>
                    </tr>
                  </thead>
                  <tbody class="divide-y divide-gray-100">
                    <% changes.each do |attribute, (before, after)| %>
                      <tr>
                        <td class="px-3 py-2 font-medium text-gray-700 align-top"><%= service_history_attribute_name(attribute) %></td>
                        <td class="px-3 py-2 text-gray-500 align-top break-words"><%= service_history_value(attribute, before) %></td>
                        <td class="px-3 py-2 text-gray-900 align-top break-words"><%= service_history_value(attribute, after) %></td>
                      </tr>
                    <% end %>
                  </tbody>
                </table>
              </div>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>
  </div>
</div>
