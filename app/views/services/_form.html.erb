<%= form_with(model: service, class: "space-y-6") do |form| %>
  <% if service.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-800 rounded-lg p-4">
      <h2 class="font-semibold mb-2"><%= t("services.form.errors.title", count: service.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% service.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= form.hidden_field :guard_id %>

  <div>
    <%= form.label :full_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :full_name, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :age, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.number_field :age, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :due_date, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.date_field :due_date, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :caller_full_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :caller_full_name, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :caller_phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :caller_phone, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :caller_relationship, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :caller_relationship, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :comments, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_area :comments, rows: 3, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :place, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.select :place, Service.places.keys.map { |p| [t("services.place.#{p}"), p] }, { include_blank: true }, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div data-controller="address-map"
       data-address-map-initial-address-value="<%= service.address %>">
    <%= form.label :address, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :address,
          data: { address_map_target: "input", action: "input->address-map#search" },
          class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    <div data-address-map-target="map"
         class="mt-2 rounded-md overflow-hidden border border-gray-200"
         style="height: 400px;"></div>
  </div>

  <div>
    <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>
<% end %>
