<div id="<%= dom_id service %>" class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">

  <%# Header %>
  <% header_class = service.pending? ? "bg-gradient-to-r from-red-100 to-white" : "bg-gradient-to-r from-green-100 to-white" %>
  <% date_class   = service.pending? ? "text-red-500" : "text-green-600" %>
  <% icon_class   = service.pending? ? "bg-red-200 text-red-700" : "bg-green-200 text-green-700" %>
  <div class="px-6 py-5 <%= header_class %> border-b border-gray-100">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4">
      <div class="flex items-center gap-4 min-w-0">
        <div class="flex items-center justify-center w-12 h-12 rounded-full <%= icon_class %> shrink-0">
          <i class="ph ph-hand-heart text-xl"></i>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-medium <%= date_class %> uppercase tracking-wide"><%= l(service.due_date, format: :long) %></p>
          <h2 class="text-xl font-bold text-gray-900 mt-0.5 truncate"><%= service.full_name %></h2>
          <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-gray-500">
            <% if service.age.present? %>
              <span class="flex items-center gap-1.5">
                <i class="ph ph-user"></i> <%= Service.human_attribute_name(:age) %>: <%= service.age %>
              </span>
            <% end %>
            <span class="flex items-center gap-1.5">
              <i class="ph ph-shield text-indigo-500"></i>
              <%= Service.human_attribute_name(:guard) %>:
              <%= link_to l(service.guard.due_date, format: :long), service.guard, class: "font-medium text-indigo-600 hover:underline" %>
            </span>
          </div>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2 sm:justify-end shrink-0">
        <% if service.nro.present? %>
          <span class="badge_blue">NRO <%= service.nro %></span>
        <% end %>
        <% status_class = service.pending? ? "badge_red" : "badge_green" %>
        <span class="<%= status_class %>"><%= t("services.status.#{service.status}") %></span>
      </div>
    </div>
  </div>

  <% if service.pending? && service.guard&.closed? %>
    <div class="px-6 py-3 border-b border-amber-200 bg-amber-50 flex items-center gap-2 text-sm font-medium text-amber-700">
      <i class="ph ph-warning text-base shrink-0"></i>
      <span><%= t("services.show.reassign_to_open_guard") %></span>
    </div>
  <% end %>

  <div class="divide-y divide-gray-100">

    <%# Patient info %>
    <% if service.pathology.present? || service.health_status.present? || service.sacraments.present? %>
      <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <% if service.pathology.present? %>
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-orange-100 text-orange-600 shrink-0 mt-0.5">
              <i class="ph ph-heartbeat text-sm"></i>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Service.human_attribute_name(:pathology) %></p>
              <p class="text-sm text-gray-900 mt-0.5"><%= service.pathology %></p>
            </div>
          </div>
        <% end %>
        <% if service.health_status.present? %>
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-blue-100 text-blue-600 shrink-0 mt-0.5">
              <i class="ph ph-activity text-sm"></i>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Service.human_attribute_name(:health_status) %></p>
              <p class="text-sm text-gray-900 mt-0.5"><%= service.health_status %></p>
            </div>
          </div>
        <% end %>
        <% if service.sacraments.present? %>
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-purple-100 text-purple-600 shrink-0 mt-0.5">
              <i class="ph ph-cross text-sm"></i>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Service.human_attribute_name(:sacraments) %></p>
              <p class="text-sm text-gray-900 mt-0.5"><%= service.sacraments %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
    <%# Caller info %>
    <% if service.caller_full_name.present? || service.caller_phone.present? || service.caller_relationship.present? %>
      <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <% if service.caller_full_name.present? %>
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500 shrink-0 mt-0.5">
              <i class="ph ph-user text-sm"></i>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Service.human_attribute_name(:caller_full_name) %></p>
              <p class="text-sm text-gray-900 mt-0.5"><%= service.caller_full_name %></p>
            </div>
          </div>
        <% end %>
        <% if service.caller_phone.present? %>
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500 shrink-0 mt-0.5">
              <i class="ph ph-phone text-sm"></i>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Service.human_attribute_name(:caller_phone) %></p>
              <p class="text-sm text-gray-900 mt-0.5"><%= service.caller_phone %></p>
            </div>
          </div>
        <% end %>
        <% if service.caller_relationship.present? %>
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500 shrink-0 mt-0.5">
              <i class="ph ph-users text-sm"></i>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Service.human_attribute_name(:caller_relationship) %></p>
              <p class="text-sm text-gray-900 mt-0.5"><%= service.caller_relationship %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Health facility %>
    <% if service.health_facility.present? || service.health_facility_place.present? || service.address.present? %>
      <div class="px-6 py-4 grid grid-cols-1 sm:grid-cols-3 gap-4">
        <% if service.health_facility.present? %>
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-teal-100 text-teal-600 shrink-0 mt-0.5">
              <i class="ph ph-hospital text-sm"></i>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Service.human_attribute_name(:health_facility) %></p>
              <span class="badge_purple mt-1 inline-block">
                <%= link_to service.health_facility.name, service.health_facility, class: "hover:underline" %>
              </span>
            </div>
          </div>
        <% end %>
        <% if service.health_facility_place.present? %>
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500 shrink-0 mt-0.5">
              <i class="ph ph-door text-sm"></i>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Service.human_attribute_name(:health_facility_place) %></p>
              <p class="text-sm text-gray-900 mt-0.5"><%= service.health_facility_place %></p>
            </div>
          </div>
        <% end %>
        <% if service.address.present? %>
          <div class="flex items-start gap-3">
            <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500 shrink-0 mt-0.5">
              <i class="ph ph-map-pin text-sm"></i>
            </div>
            <div>
              <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Service.human_attribute_name(:address) %></p>
              <p class="text-sm text-gray-900 mt-0.5"><%= service.address %></p>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Comments %>
    <% if service.comments.present? %>
      <div class="px-6 py-4 flex items-start gap-3">
        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-100 text-gray-500 shrink-0 mt-0.5">
          <i class="ph ph-note text-sm"></i>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= Service.human_attribute_name(:comments) %></p>
          <p class="text-sm text-gray-700 mt-0.5"><%= service.comments %></p>
        </div>
      </div>
    <% end %>

  </div>

  <%# Map %>
  <% map_address = service.address.presence || service.health_facility&.address %>
  <% if map_address.present? %>
    <div class="border-t border-gray-100">
      <div class="flex items-center justify-between px-6 py-3">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide flex items-center gap-1.5">
          <i class="ph ph-map-trifold"></i> <%= t("services.show.map") %>
        </p>
        <%= link_to "https://maps.google.com/?q=#{URI.encode_uri_component(map_address)}", target: "_blank", rel: "noopener", class: "text-xs text-indigo-600 hover:underline flex items-center gap-1" do %>
          <i class="ph ph-arrow-square-out"></i> <%= t("services.show.open_in_maps") %>
        <% end %>
      </div>
      <div data-controller="address-map"
           data-address-map-initial-address-value="<%= map_address %>">
        <div data-address-map-target="map" class="w-full h-80"></div>
      </div>
    </div>
  <% end %>

  <%# Actions %>
  <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-end gap-2">
    <% clipboard_text = [
         "#{Service.human_attribute_name(:full_name)}: #{service.full_name}",
         ("#{Service.human_attribute_name(:health_status)}: #{service.health_status}" if service.health_status.present?),
         ("#{Service.human_attribute_name(:address)}: #{service.address}" if service.address.present?),
         ("#{Service.human_attribute_name(:address)}: https://www.google.com/maps/search/#{ERB::Util.url_encode(service.address)}" if service.address.present?),
         ("#{Service.human_attribute_name(:caller_full_name)}: #{service.caller_full_name}" if service.caller_full_name.present?),
         ("#{Service.human_attribute_name(:caller_phone)}: #{service.caller_phone}" if service.caller_phone.present?),
         ("#{Service.human_attribute_name(:caller_relationship)}: #{service.caller_relationship}" if service.caller_relationship.present?),
         ("#{Service.human_attribute_name(:health_facility)}: #{service.health_facility.name}" if service.health_facility.present?),
         ("#{Service.human_attribute_name(:health_facility_place)}: #{service.health_facility_place}" if service.health_facility_place.present?)
       ].compact.join("\n") %>
    <button type="button"
            data-controller="clipboard"
            data-clipboard-text-value="<%= clipboard_text %>"
            data-action="click->clipboard#copy"
            class="w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
      <i class="ph ph-copy" data-clipboard-target="icon"></i> <%= t("services.show.copy") %>
    </button>
    <% if policy(service).edit? %>
      <%= link_to edit_service_path(service), class: "w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
        <i class="ph ph-pencil-simple"></i> <%= t("services.show.edit") %>
      <% end %>
    <% end %>
    <%= link_to pdf_service_path(service), target: "_blank", class: "w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
      <i class="ph ph-printer text-red-500"></i> <%= t("services.show.print_pdf") %>
    <% end %>
    <% if policy(service).complete? %>
      <%= button_to complete_service_path(service), form: { class: "w-full sm:w-auto" }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
        <%= t("services.show.complete") %>
      <% end %>
    <% end %>
    <% if policy(service).history? %>
      <%= link_to history_service_path(service), class: "w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
        <i class="ph ph-clock-counter-clockwise"></i> <%= t("services.show.history") %>
      <% end %>
    <% end %>
    <% if policy(service).destroy? %>
      <%= button_to service, method: :delete, form: { class: "w-full sm:w-auto", data: { turbo_confirm: t("services.show.destroy_confirm") } }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
        <i class="ph ph-trash"></i> <%= t("services.show.destroy") %>
      <% end %>
    <% end %>
  </div>
</div>
