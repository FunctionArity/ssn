<%# locals: (token:) %>
<%# The token just created, in full. It's the only time it shows: only its jti and last characters are kept. %>
<div class="px-6 py-4 border-b border-green-100 bg-green-50">
  <p class="flex items-center gap-2 text-sm font-semibold text-green-800">
    <i class="ph ph-check-circle text-lg"></i> <%= t("personal_access_tokens.new_token.title") %>
  </p>
  <p class="mt-1 text-sm text-green-700"><%= t("personal_access_tokens.new_token.copy_now") %></p>
  <div class="mt-3 flex flex-col gap-2 sm:flex-row sm:items-start">
    <code id="new_personal_access_token_value" class="flex-1 min-w-0 break-all text-xs bg-white border border-green-200 rounded-md px-3 py-2 text-gray-800"><%= token.token %></code>
    <button type="button"
            data-controller="clipboard"
            data-clipboard-text-value="<%= token.token %>"
            data-action="click->clipboard#copy"
            class="cursor-pointer self-start shrink-0 flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50">
      <i class="ph ph-copy" data-clipboard-target="icon"></i> <%= t("personal_access_tokens.new_token.copy") %>
    </button>
  </div>
</div>
