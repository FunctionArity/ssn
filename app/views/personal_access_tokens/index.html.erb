<div class="py-8">
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 flex items-center gap-4 bg-gradient-to-r from-gray-100 to-white border-b border-gray-100">
      <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-gray-200 text-gray-700 shrink-0">
        <i class="ph ph-key text-xl"></i>
      </div>
      <h1 class="text-xl font-bold text-gray-900"><%= t(".title") %></h1>
      <%= button_to personal_access_tokens_path, method: :post, form: { class: "ml-auto" },
            class: "cursor-pointer flex items-center gap-2 rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors" do %>
        <i class="ph ph-plus text-base"></i>
        <span><%= t(".create") %></span>
      <% end %>
    </div>

    <div class="px-6 py-4 text-sm text-gray-600 border-b border-gray-100 bg-gray-50/60 space-y-1">
      <p><%= t(".intro", days: PersonalAccessToken::LIFETIME.in_days.to_i) %></p>
      <p>
        <%= t(".usage") %>
        <code class="text-xs bg-white border border-gray-200 rounded px-1.5 py-0.5">Authorization: Bearer &lt;token&gt;</code>
        &middot;
        <code class="text-xs bg-white border border-gray-200 rounded px-1.5 py-0.5"><%= "#{request.base_url}/api/v1/me" %></code>
      </p>
    </div>

    <div id="new_personal_access_token">
      <%= render "new_token", token: @new_token if @new_token %>
    </div>

    <div id="personal_access_tokens">
      <%= render "list", tokens: @tokens %>
    </div>
  </div>
</div>
