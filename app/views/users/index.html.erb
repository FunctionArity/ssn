<div class="py-8">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold"><%= t(".title") %></h1>
    <%= link_to t(".new_user"), new_user_path, class: "rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>

  <div id="users" class="space-y-4">
    <% @users.each do |user| %>
      <div class="border border-gray-200 rounded-lg p-4 flex items-center justify-between">
        <div>
          <p class="font-semibold">
            <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= user.role_badge_class %>"><%= t("activerecord.attributes.user.roles.#{user.role}") %></span>
            <%= user.first_name %> <%= user.last_name %>
          </p>
          <p class="text-sm text-gray-500"><%= user.email %></p>
        </div>
        <%= link_to t(".show"), user, class: "text-blue-600 hover:underline text-sm" %>
      </div>
    <% end %>
  </div>
</div>
