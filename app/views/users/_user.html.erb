<div id="<%= dom_id user %>" class="border border-gray-200 rounded-lg p-6 space-y-3">
  <p>
    <span class="text-sm font-medium text-gray-500"><%= User.human_attribute_name(:first_name) %></span><br>
    <span class="text-gray-900"><%= user.first_name %></span>
  </p>

  <p>
    <span class="text-sm font-medium text-gray-500"><%= User.human_attribute_name(:last_name) %></span><br>
    <span class="text-gray-900"><%= user.last_name %></span>
  </p>

  <p>
    <span class="text-sm font-medium text-gray-500"><%= User.human_attribute_name(:email) %></span><br>
    <span class="text-gray-900"><%= user.email %></span>
  </p>
</div>
