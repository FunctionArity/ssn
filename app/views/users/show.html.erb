<div class="max-w-lg mx-auto py-8">
  <% if notice.present? %>
    <p class="mb-4 rounded-lg bg-green-50 border border-green-300 text-green-800 p-3"><%= notice %></p>
  <% end %>

  <%= render @user %>

  <div class="mt-6 flex items-center gap-4">
    <%= link_to t(".edit"), edit_user_path(@user), class: "text-blue-600 hover:underline" %>
    <%= link_to t(".back"), users_path, class: "text-blue-600 hover:underline" %>
    <%= button_to t(".destroy"), @user, method: :delete, class: "cursor-pointer rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" %>
  </div>
</div>
