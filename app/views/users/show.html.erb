<% role_gradient = { "guardian" => "from-green-100", "vocal" => "from-red-100", "priest" => "from-purple-100" } %>
<% role_icon_bg   = { "guardian" => "bg-green-200 text-green-700", "vocal" => "bg-red-200 text-red-700", "priest" => "bg-purple-200 text-purple-700" } %>

<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to users_path, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <div id="<%= dom_id @user %>" class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

    <%# Header %>
    <div class="px-6 py-5 flex items-center gap-4 bg-gradient-to-r <%= role_gradient[@user.role] %> to-white border-b border-gray-100">
      <% if @user.avatar.attached? %>
        <img src="<%= url_for(@user.avatar) %>"
             class="w-11 h-11 rounded-xl object-cover border border-gray-200 shadow-sm shrink-0">
      <% else %>
        <div class="flex items-center justify-center w-11 h-11 rounded-xl <%= role_icon_bg[@user.role] %>">
          <i class="ph ph-user text-xl"></i>
        </div>
      <% end %>
      <h1 class="text-xl font-bold text-gray-900"><%= @user.full_name %></h1>
    </div>

    <%# Details %>
    <div class="px-6 py-6 space-y-4">
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide"><%= t("activerecord.models.user.one") %></p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:first_name) %></p>
          <p class="mt-1 text-sm text-gray-900"><%= @user.first_name %></p>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:last_name) %></p>
          <p class="mt-1 text-sm text-gray-900"><%= @user.last_name %></p>
        </div>
        <div class="sm:col-span-2">
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:email) %></p>
          <p class="mt-1 text-sm text-gray-900"><%= @user.email %></p>
        </div>
        <% if @user.phone.present? %>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:phone) %></p>
            <p class="mt-1 text-sm text-gray-900"><i class="ph ph-phone text-gray-400"></i> <%= @user.phone %></p>
          </div>
        <% end %>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:role) %></p>
          <div class="mt-1">
            <span class="<%= @user.role_badge_class %>"><%= t("activerecord.attributes.user.roles.#{@user.role}") %></span>
          </div>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= t(".status") %></p>
          <div class="mt-1 flex flex-wrap gap-1.5">
            <% if @user.access_locked? %>
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-red-600 bg-red-50 border border-red-200 rounded-md px-2 py-0.5">
                <i class="ph ph-lock-simple"></i> <%= t(".locked") %>
              </span>
            <% end %>
            <% unless @user.invitation_accepted_at? %>
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-amber-600 bg-amber-50 border border-amber-200 rounded-md px-2 py-0.5">
                <i class="ph ph-envelope"></i> <%= t(".invitation_pending") %>
              </span>
            <% end %>
            <% if @user.invitation_accepted_at? && !@user.access_locked? %>
              <span class="inline-flex items-center gap-1.5 text-xs font-medium text-green-600 bg-green-50 border border-green-200 rounded-md px-2 py-0.5">
                <i class="ph ph-check-circle"></i> <%= t(".active") %>
              </span>
            <% end %>
          </div>
        </div>
      </div>
    </div>

    <%# Actions %>
    <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-end gap-2">
      <% if @user.access_locked? %>
        <%= button_to unlock_user_path(@user), method: :patch, form: { class: "w-full sm:w-auto" }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500" do %>
          <i class="ph ph-lock-simple-open"></i> <%= t(".unlock") %>
        <% end %>
      <% else %>
        <%= button_to lock_user_path(@user), method: :patch, form: { class: "w-full sm:w-auto", data: { turbo_confirm: t(".lock_confirm") } }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-400" do %>
          <i class="ph ph-lock-simple"></i> <%= t(".lock") %>
        <% end %>
      <% end %>
      <% unless @user.invitation_accepted_at? %>
        <%= button_to resend_invitation_user_path(@user), method: :post, form: { class: "w-full sm:w-auto" }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
          <i class="ph ph-envelope"></i> <%= t(".resend_invitation") %>
        <% end %>
      <% end %>
      <%= link_to edit_user_path(@user), class: "w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
        <i class="ph ph-pencil-simple"></i> <%= t("edit") %>
      <% end %>
      <%= button_to @user, method: :delete, form: { class: "w-full sm:w-auto", data: { turbo_confirm: t(".destroy_confirm") } }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
        <i class="ph ph-trash"></i> <%= t("destroy") %>
      <% end %>
    </div>

  </div>
</div>
