<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to users_path, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <%
    avatar_class = case @user.role
      when "guardian" then "bg-green-100 text-green-700"
      when "vocal"    then "bg-red-100 text-red-700"
      when "priest"   then "bg-purple-100 text-purple-700"
    end
    accent_class = case @user.role
      when "guardian" then "border-t-green-500"
      when "vocal"    then "border-t-red-500"
      when "priest"   then "border-t-purple-500"
    end
  %>

  <div id="<%= dom_id @user %>" class="bg-white border border-gray-200 border-t-4 <%= accent_class %> rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-6 flex items-center gap-5 border-b border-gray-100">
      <div class="flex items-center justify-center w-16 h-16 rounded-full text-2xl font-bold shrink-0 <%= avatar_class %>">
        <%= @user.first_name[0] %><%= @user.last_name[0] %>
      </div>
      <div>
        <h2 class="text-xl font-bold text-gray-900"><%= @user.full_name %></h2>
      </div>
    </div>

    <div class="px-6 py-5 grid grid-cols-2 gap-x-8 gap-y-4">
      <div>
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:first_name) %></p>
        <p class="mt-1 text-sm text-gray-900"><%= @user.first_name %></p>
      </div>
      <div>
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:last_name) %></p>
        <p class="mt-1 text-sm text-gray-900"><%= @user.last_name %></p>
      </div>
      <div class="col-span-2">
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:email) %></p>
        <p class="mt-1 text-sm text-gray-900"><%= @user.email %></p>
      </div>
      <% if @user.phone.present? %>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:phone) %></p>
          <p class="mt-1 text-sm text-gray-900"><i class="ph ph-phone text-gray-400"></i> <%= @user.phone %></p>
        </div>
      <% end %>
      <div>
        <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:role) %></p>
        <div class="mt-1">
          <span class="<%= @user.role_badge_class %>"><%= t("activerecord.attributes.user.roles.#{@user.role}") %></span>
        </div>
      </div>
    </div>

    <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-between gap-3">
      <div>
        <% if @user.access_locked? %>
          <span class="inline-flex items-center gap-1.5 text-xs font-medium text-red-600 bg-red-50 border border-red-200 rounded-md px-3 py-1.5">
            <i class="ph ph-lock-simple"></i> <%= t(".locked") %>
          </span>
        <% end %>
      </div>
      <div class="flex items-center gap-3">
        <% if @user.access_locked? %>
          <%= button_to unlock_user_path(@user), method: :patch, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500" do %>
            <i class="ph ph-lock-simple-open"></i> <%= t(".unlock") %>
          <% end %>
        <% else %>
          <%= button_to lock_user_path(@user), method: :patch, form: { data: { turbo_confirm: t(".lock_confirm") } }, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-400" do %>
            <i class="ph ph-lock-simple"></i> <%= t(".lock") %>
          <% end %>
        <% end %>
        <%= link_to edit_user_path(@user), class: "flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
          <i class="ph ph-pencil-simple"></i> <%= t("edit") %>
        <% end %>
        <%= button_to @user, method: :delete, form: { data: { turbo_confirm: t(".destroy_confirm") } }, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
          <i class="ph ph-trash"></i> <%= t("destroy") %>
        <% end %>
      </div>
    </div>
  </div>
</div>
