<% role_gradient = { "guardian" => "from-green-100", "vocal" => "from-red-100", "priest" => "from-purple-100" } %>
<% role_icon_bg   = { "guardian" => "bg-green-200 text-green-700", "vocal" => "bg-red-200 text-red-700", "priest" => "bg-purple-200 text-purple-700" } %>

<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to users_path, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <div id="<%= dom_id @user %>" class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">

    <%# Header %>
    <div class="px-6 pt-8 pb-6 flex flex-col items-center bg-gradient-to-b <%= role_gradient[@user.role] %> to-white border-b border-gray-100">
      <% if @user.avatar.attached? %>
        <div data-controller="avatar-fallback">
          <img src="<%= url_for(@user.avatar) %>"
               data-avatar-fallback-target="image"
               data-action="error->avatar-fallback#fallback"
               class="w-24 h-24 rounded-full object-cover border-4 border-white shadow-md shrink-0">
          <div data-avatar-fallback-target="placeholder" class="hidden items-center justify-center w-24 h-24 rounded-full <%= role_icon_bg[@user.role] %> border-4 border-white shadow-md">
            <i class="ph ph-user text-4xl"></i>
          </div>
        </div>
      <% else %>
        <div class="flex items-center justify-center w-24 h-24 rounded-full <%= role_icon_bg[@user.role] %> border-4 border-white shadow-md">
          <i class="ph ph-user text-4xl"></i>
        </div>
      <% end %>
      <h1 class="mt-3 text-xl font-bold text-gray-900"><%= @user.full_name %></h1>
      <span class="mt-1 <%= @user.role_badge_class %>"><%= t("activerecord.attributes.user.roles.#{@user.role}") %></span>
    </div>

    <%# Details %>
    <div class="px-6 py-6 space-y-4">
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:email) %></p>
          <p class="mt-1 text-sm text-gray-900"><%= @user.email %></p>
        </div>
        <div>
          <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= t(".status") %></p>
          <%# Where the invitation stands, with its date, then whether the user is active: signed in at least
              once and not locked. The full date and time is on hover. %>
          <% status_badge = ->(text, icon, color, time = nil) {
               tag.span(class: "inline-flex items-center gap-1.5 text-xs font-medium rounded-md border px-2 py-0.5 #{color}", title: (l(time, format: :long) if time)) do
                 safe_join([ tag.i(class: "ph #{icon}"), text, (tag.span("· #{l(time.to_date)}", class: "font-normal") if time) ].compact, " ")
               end
             } %>
          <div class="mt-1 flex flex-wrap gap-1.5">
            <% if @user.pending_activation? %>
              <%# Invited and not accepted, or without a password; until an invitation is emailed, it's just pending. %>
              <%= status_badge.(t(@user.invitation_sent_at ? ".invitation_sent" : ".invitation_pending"), "ph-envelope", "text-amber-600 bg-amber-50 border-amber-200", @user.invitation_sent_at) %>
            <% elsif @user.invitation_accepted? %>
              <%= status_badge.(t(".invitation_accepted"), "ph-check-circle", "text-green-600 bg-green-50 border-green-200", @user.invitation_accepted_at) %>
            <% end %>
            <% if @user.access_locked? %>
              <%= status_badge.(t(".locked"), "ph-lock-simple", "text-red-600 bg-red-50 border-red-200", @user.locked_at) %>
            <% elsif @user.sign_in_count.positive? %>
              <%= status_badge.(t(".active"), "ph-check-circle", "text-green-600 bg-green-50 border-green-200") %>
            <% elsif !@user.pending_activation? %>
              <%# Not invited (e.g. created by seeds) and never signed in, so it isn't left without a status. %>
              <%= status_badge.(t(".never_signed_in"), "ph-clock", "text-gray-500 bg-gray-50 border-gray-200") %>
            <% end %>
          </div>
          <%# For active users. Devise's current_sign_in_at is the latest sign-in; last_sign_in_at the one before it. %>
          <% signed_in_at = @user.current_sign_in_at || @user.last_sign_in_at %>
          <% if !@user.access_locked? && @user.sign_in_count.positive? && signed_in_at %>
            <p class="mt-1.5 flex items-center gap-1 text-xs text-gray-500" title="<%= l(signed_in_at, format: :long) %>">
              <i class="ph ph-sign-in"></i> <%= t(".last_signed_in", time: l(signed_in_at, format: :short)) %>
            </p>
          <% end %>
        </div>
        <% if @user.phone.present? %>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:phone) %></p>
            <p class="mt-1 text-sm text-gray-900"><i class="ph ph-phone text-gray-400"></i> <%= @user.phone %></p>
          </div>
        <% end %>
        <% if @user.dni.present? %>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:dni) %></p>
            <p class="mt-1 text-sm text-gray-900"><%= @user.dni %></p>
          </div>
        <% end %>
        <% if @user.date_of_birth.present? %>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:date_of_birth) %></p>
            <p class="mt-1 text-sm text-gray-900"><i class="ph ph-cake text-gray-400"></i> <%= l(@user.date_of_birth, format: :long) %></p>
          </div>
        <% end %>
        <% if @user.start_day.present? %>
          <div>
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:start_day) %></p>
            <p class="mt-1 text-sm text-gray-900"><i class="ph ph-calendar text-gray-400"></i> <%= l(@user.start_day, format: :long) %></p>
          </div>
        <% end %>
        <% if @user.address.present? || @user.city.present? %>
          <div class="sm:col-span-2">
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide"><%= User.human_attribute_name(:address) %></p>
            <p class="mt-1 text-sm text-gray-900"><i class="ph ph-map-pin text-gray-400"></i> <%= [ @user.address, @user.city ].compact_blank.join(", ") %></p>
          </div>
        <% end %>
      </div>
    </div>

    <%# Guard Setups %>
    <% if @user.guardian? && @user.guard_setups.any? %>
      <div class="px-6 py-6 border-t border-gray-100 space-y-3">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide"><%= t(".guard_setups") %></p>
        <div class="flex flex-wrap gap-2">
          <% @user.guard_setups.order(:day_number).each do |gs| %>
            <%= link_to guard_setup_path(gs), class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-blue-50 border border-blue-200 text-sm font-medium text-blue-700 hover:bg-blue-100" do %>
              <i class="ph ph-shield"></i>
              <%= t(".guard_day", number: gs.day_number) %>
              <span class="text-blue-400 font-normal"><%= gs.vocal.full_name %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Church %>
    <% if @user.priest? && @user.church.present? %>
      <div class="px-6 py-6 border-t border-gray-100 space-y-3">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide"><%= t(".church") %></p>
        <div class="flex items-start gap-3">
          <div class="flex items-center justify-center w-9 h-9 rounded-full bg-purple-100 text-purple-700 shrink-0">
            <i class="ph ph-church"></i>
          </div>
          <div class="space-y-1">
            <%= link_to @user.church, class: "text-sm font-semibold text-gray-900 hover:underline" do %><%= @user.church.name %><% end %>
            <% if @user.church.address.present? %>
              <p class="text-xs text-gray-500"><i class="ph ph-map-pin text-gray-400"></i> <%= @user.church.address %></p>
            <% end %>
            <% if @user.church.phone.present? %>
              <p class="text-xs text-gray-500"><i class="ph ph-phone text-gray-400"></i> <%= @user.church.phone %></p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Vocal Guard Setups %>
    <% if @user.vocal? && @user.vocal_guard_setups.any? %>
      <div class="px-6 py-6 border-t border-gray-100 space-y-3">
        <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide"><%= t(".vocal_guard_setups") %></p>
        <div class="flex flex-wrap gap-2">
          <% @user.vocal_guard_setups.order(:day_number).each do |gs| %>
            <%= link_to guard_setup_path(gs), class: "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-red-50 border border-red-200 text-sm font-medium text-red-700 hover:bg-red-100" do %>
              <i class="ph ph-shield"></i>
              <%= t(".guard_day", number: gs.day_number) %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Actions %>
    <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-end gap-2">
      <% if policy(@user).impersonate? && current_user != @user %>
        <%= button_to impersonate_user_path(@user), method: :post, form: { class: "w-full sm:w-auto" }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-violet-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-violet-500" do %>
          <i class="ph ph-detective"></i> <%= t(".impersonate") %>
        <% end %>
      <% end %>
      <% if @user.access_locked? && policy(@user).unlock? %>
        <%= button_to unlock_user_path(@user), method: :patch, form: { class: "w-full sm:w-auto" }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-green-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-green-500" do %>
          <i class="ph ph-lock-simple-open"></i> <%= t(".unlock") %>
        <% end %>
      <% elsif !@user.access_locked? && policy(@user).lock? %>
        <%= button_to lock_user_path(@user), method: :patch, form: { class: "w-full sm:w-auto", data: { turbo_confirm: t(".lock_confirm"), turbo_confirm_title: t(".lock_confirm_title"), turbo_confirm_level: "warning" } }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-amber-500 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-amber-400" do %>
          <i class="ph ph-lock-simple"></i> <%= t(".lock") %>
        <% end %>
      <% end %>
      <% if @user.invitation_needed? && policy(@user).resend_invitation? %>
        <%= button_to resend_invitation_user_path(@user), method: :post, form: { class: "w-full sm:w-auto" }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500" do %>
          <i class="ph ph-envelope"></i> <%= t(@user.invitation_sent_at ? ".resend_invitation" : ".send_invitation") %>
        <% end %>
      <% end %>
      <% if policy(@user).edit? %>
        <%= link_to edit_user_path(@user), class: "w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
          <i class="ph ph-pencil-simple"></i> <%= t("edit") %>
        <% end %>
      <% end %>
      <% if policy(@user).history? && @user.versions.count > 0%>
        <%= link_to history_user_path(@user), class: "w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
          <i class="ph ph-clock-counter-clockwise"></i> <%= t(".history") %>
          <span class="ml-0.5 min-w-5 rounded-full bg-gray-100 px-1.5 text-xs font-semibold text-gray-600 tabular-nums text-center"><%= @user.versions.count %></span>
        <% end %>
      <% end %>
      <% if policy(@user).destroy? %>
        <%= button_to @user, method: :delete, form: { class: "w-full sm:w-auto", data: { turbo_confirm: t(".destroy_confirm"), turbo_confirm_title: t(".destroy_confirm_title"), turbo_confirm_level: "danger" } }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
          <i class="ph ph-trash"></i> <%= t("destroy") %>
        <% end %>
      <% end %>
    </div>

  </div>
</div>
