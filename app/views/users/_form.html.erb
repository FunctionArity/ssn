<%= form_with(model: user, class: "space-y-5") do |form| %>
  <% if user.errors.any? %>
    <div class="flex items-start gap-3 bg-red-50 border border-red-200 text-red-800 rounded-xl p-4">
      <i class="ph ph-warning-circle text-lg text-red-500 shrink-0 mt-0.5"></i>
      <div>
        <p class="font-semibold text-sm mb-1"><%= t("users.form.errors.title", count: user.errors.count) %></p>
        <ul class="list-disc list-inside text-sm space-y-0.5">
          <% user.errors.each do |error| %>
            <li><%= error.full_message %></li>
          <% end %>
        </ul>
      </div>
    </div>
  <% end %>

  <%# Personal info %>
  <div class="space-y-4">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide"><%= t("activerecord.models.user.one") %></p>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= form.text_field :first_name, class: "w-full rounded-md border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
      <div>
        <%= form.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= form.text_field :last_name, class: "w-full rounded-md border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-4">
      <div>
        <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= form.text_field :email, class: "w-full rounded-md border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
      <div>
        <%= form.label :phone, class: "block text-sm font-medium text-gray-700 mb-1.5" %>
        <%= form.telephone_field :phone, class: "w-full rounded-md border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-100"></div>

  <%# Role & credentials %>
  <div data-controller="role-selector" class="space-y-4">
    <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide"><%= t("activerecord.attributes.user.role") %></p>

    <div>
      <%# role-selector JS-dynamic classes (keep for Tailwind scanner): bg-green-50 text-green-700 ring-green-600/20 bg-red-50 text-red-700 ring-red-600/10 bg-purple-50 text-purple-700 ring-purple-700/10 %>
      <div class="relative flex rounded-md border border-gray-200 overflow-hidden bg-white shadow-sm">
        <div data-role-selector-target="pill" class="absolute inset-y-1 rounded-md ring-1 ring-inset transition-all duration-300 ease-in-out pointer-events-none"></div>
        <% User.roles.keys.each_with_index do |role, i| %>
          <label data-role-selector-target="label" data-role="<%= role %>"
                 class="relative flex-1 cursor-pointer text-gray-600 z-10 transition-colors duration-300 <%= i > 0 ? "border-gray-200" : "" %>">
            <%= form.radio_button :role, role, class: "sr-only", data: { action: "change->role-selector#change" } %>
            <span class="block px-4 py-2.5 text-sm font-medium text-center">
              <%= t("activerecord.attributes.user.roles.#{role}") %>
            </span>
          </label>
        <% end %>
      </div>
    </div>

    <% church_addresses = @churches.each_with_object({}) { |c, h| h[c.id.to_s] = c.address } %>
    <div data-role-selector-target="priestSection"
         data-controller="church-map"
         data-church-map-addresses-value="<%= church_addresses.to_json %>"
         class="space-y-3 <%= user.priest? ? "" : "hidden" %>">
      <%= form.label :church_id, t("activerecord.attributes.user.church"), class: "block text-sm font-medium text-gray-700 mb-1.5" %>
      <%= form.collection_select :church_id, @churches, :id, :name,
            { include_blank: t("users.form.select_church") },
            class: "w-full rounded-md border border-gray-300 px-3 py-2.5 text-sm shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500",
            data: { church_map_target: "select", action: "change->church-map#selectChurch" } %>
      <div data-church-map-target="map" class="w-full h-56 rounded-lg overflow-hidden border border-gray-200"></div>
    </div>

  </div>

  <div class="border-t border-gray-100 pt-4 flex justify-end">
    <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors" %>
  </div>
<% end %>
