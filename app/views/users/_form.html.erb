<%= form_with(model: user, class: "space-y-6") do |form| %>
  <% if user.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-800 rounded-lg p-4">
      <h2 class="font-semibold mb-2"><%= t("users.form.errors.title", count: user.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% user.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :first_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :first_name, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :last_name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :last_name, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :email, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>
<% end %>
