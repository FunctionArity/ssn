<% role_icon_bg = { "guardian" => "bg-green-200 text-green-700", "vocal" => "bg-red-200 text-red-700", "priest" => "bg-purple-200 text-purple-700" } %>

<turbo-frame id="mention_card" target="_top">
  <div class="flex items-center gap-3">
    <% if @user.avatar.attached? %>
      <div data-controller="avatar-fallback" class="shrink-0">
        <img src="<%= url_for(@user.avatar) %>"
             alt=""
             data-avatar-fallback-target="image"
             data-action="error->avatar-fallback#fallback"
             class="w-10 h-10 rounded-full object-cover">
        <div data-avatar-fallback-target="placeholder" class="hidden items-center justify-center w-10 h-10 rounded-full <%= role_icon_bg[@user.role] %>">
          <i class="ph ph-user"></i>
        </div>
      </div>
    <% else %>
      <div class="flex items-center justify-center w-10 h-10 rounded-full shrink-0 <%= role_icon_bg[@user.role] %>">
        <i class="ph ph-user"></i>
      </div>
    <% end %>
    <div class="min-w-0">
      <p class="text-sm font-semibold text-gray-900 truncate"><%= @user.full_name %></p>
      <span class="<%= @user.role_badge_class %>"><%= t("activerecord.attributes.user.roles.#{@user.role}") %></span>
    </div>
  </div>

  <div class="mt-3 space-y-1 text-xs text-gray-600">
    <% if @user.phone.present? %>
      <p class="truncate"><i class="ph ph-phone text-gray-400"></i> <%= link_to @user.phone, "tel:#{@user.phone}", class: "hover:underline" %></p>
    <% end %>
    <p class="truncate"><i class="ph ph-envelope text-gray-400"></i> <%= mail_to @user.email, class: "hover:underline" %></p>
    <% if (@user.vocal? || @user.guardian?) && @user.guard_day_numbers.any? %>
      <p class="truncate"><i class="ph ph-shield text-gray-400"></i> <%= @user.guard_day_numbers.map { |number| t("users.show.guard_day", number: number) }.join(", ") %></p>
    <% end %>
    <% if @user.priest? && @user.church.present? %>
      <p class="truncate"><i class="ph ph-church text-gray-400"></i> <%= link_to @user.church.name, @user.church, class: "hover:underline" %></p>
    <% end %>
  </div>
</turbo-frame>
