<div data-controller="priest-assign-new">
  <%= render "shared/page_header",
        title: t(".title"),
        icon: "ph-calendar-plus",
        icon_class: "bg-purple-100 text-purple-700" %>

  <%# Unassigned priests panel %>
  <div id="priests-panel">
    <%= render "priests_panel", priests: @priests %>
  </div>

  <%# Assignment grid (weeks 1–4, up to day 28) %>
  <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
    <table class="table-fixed min-w-max w-full border-collapse">
      <thead>
        <tr class="border-b border-gray-100">
          <th class="w-28 px-4 py-3 text-left text-xs font-semibold text-gray-500 whitespace-nowrap"><%= t(".week") %></th>
          <% t("date.day_names").rotate(1).each do |day| %>
            <th class="w-36 min-w-36 text-center text-xs font-semibold text-gray-400 uppercase tracking-widest py-3 px-2">
              <%= day %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% t("priest_setups.week_names").each.with_index(1) do |week_name, week_idx| %>
          <tr class="group">
            <td class="px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-widest align-middle whitespace-nowrap border-r border-gray-100">
              <%= week_name %>
            </td>
            <% days = week_idx > 4 ? (1..4) : (1..7) %>
            <% days.each do |day_idx| %>
              <% slot = @day_slots.find { |s| s[:week_number] == week_idx && s[:day_of_week] == day_idx } %>
              <%= render "cell", slot: slot, week_number: week_idx, day_of_week: day_idx %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Hidden form for assignment (click and drag & drop) %>
  <%= form_with model: PriestSetup.new, url: priest_setups_path, id: "priest-assign-new-form" do |f| %>
    <%= f.hidden_field :priest_id, id: "new-form-priest-id" %>
    <%= f.hidden_field :week_number, id: "new-form-week-number" %>
    <%= f.hidden_field :day_of_week, id: "new-form-day-of-week" %>
    <input type="hidden" id="new-form-source-setup-id" name="source_setup_id" value="">
  <% end %>
</div>
