<%= render "shared/page_header",
      title: t("priest_setups.title"),
      icon: "ph-calendar",
      icon_class: "bg-purple-100 text-purple-700",
      action_label: t("priest_setups.new_priest_setup"),
      action_path: new_priest_setup_path %>

<%# Calendar %>
<% calendar_start = @start_date.beginning_of_week %>
<div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
  <table class="table-fixed min-w-max w-full border-collapse">
    <thead>
      <tr class="border-b border-gray-100">
        <th class="px-4 py-3" colspan="7">
          <div class="flex items-center gap-3">
            <%= link_to priest_setups_path(m: @start_date.prev_month.month),
                  class: "rounded-lg p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-colors" do %>
              <i class="ph ph-caret-left text-base leading-none"></i>
            <% end %>
            <span class="text-sm font-semibold text-gray-700"><%= l(@start_date, format: "%B %Y") %></span>
            <%= link_to priest_setups_path(m: @start_date.next_month.month),
                  class: "rounded-lg p-1.5 text-gray-400 hover:bg-gray-100 hover:text-gray-600 transition-colors" do %>
              <i class="ph ph-caret-right text-base leading-none"></i>
            <% end %>
          </div>
        </th>
      </tr>
      <tr class="border-b border-gray-100">
        <% t("date.day_names").rotate(1).each do |day| %>
          <th class="w-36 min-w-36 text-center text-xs font-semibold text-gray-400 uppercase tracking-widest py-3 px-2">
            <%= day %>
          </th>
        <% end %>
      </tr>
    </thead>
    <tbody class="divide-y divide-gray-100">
      <% 6.times do |week_offset| %>
        <% week_start = calendar_start + (week_offset * 7) %>
        <% next if week_start > @start_date.end_of_month %>
        <tr>
          <% 7.times do |day_offset| %>
            <% date = week_start + day_offset %>
            <% in_month = date.month == @start_date.month %>
            <% is_today = date == Date.today %>
            <% is_weekend = date.cwday >= 6 %>
            <% setup = @assignments[date] %>
            <td class="align-top h-24 w-36 min-w-36 p-2 border-r border-gray-100 last:border-r-0
                       <%= !in_month ? 'bg-gray-50/50' : is_today ? 'bg-purple-50' : is_weekend ? 'bg-gray-50' : 'bg-white' %>
                       <%= is_today ? 'ring-2 ring-inset ring-purple-400' : '' %>">
              <% if in_month %>
                <span class="block text-xs font-semibold leading-none mb-2 <%= is_today ? 'text-purple-600' : 'text-gray-400' %>">
                  <%= date.day %>
                </span>
                <% if setup %>
                  <div class="rounded-md bg-purple-100 border border-purple-200 px-2 py-1">
                    <p class="text-xs font-medium text-purple-800 leading-tight truncate"><%= setup.priest.full_name %></p>
                  </div>
                <% end %>
              <% end %>
            </td>
          <% end %>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
