<div class="flex flex-col min-h-[calc(100vh-8rem)]">
  <%# Guards row: previous | current | next %>
  <div class="flex items-start justify-center gap-3 mb-6">

    <%# Previous guard %>
    <div class="hidden sm:block sm:w-[30%] shrink-0">
      <% if @previous_guard %>
        <%= link_to @previous_guard, class: "group bg-white border border-gray-200 rounded-md shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col opacity-60 hover:opacity-80" do %>
          <div class="px-4 py-3 flex items-center justify-between bg-gradient-to-r from-gray-50 to-white border-b border-gray-100">
            <p class="text-xs font-medium text-gray-400 uppercase tracking-wide">Anterior</p>
            <span class="text-base font-bold text-gray-400"># <%= @previous_guard.day_number %></span>
          </div>
          <div class="px-4 py-3 flex flex-col gap-1.5 grow">
            <p class="text-xs text-gray-400"><%= l(@previous_guard.due_date, format: :long) %></p>
            <div class="flex items-center gap-1.5">
              <i class="ph ph-cross text-xs text-purple-400 shrink-0"></i>
              <p class="text-xs text-gray-600 truncate"><%= @previous_guard.priest.full_name %></p>
            </div>
            <div class="flex items-center gap-1.5">
              <i class="ph ph-user text-xs text-red-400 shrink-0"></i>
              <p class="text-xs text-gray-600 truncate"><%= @previous_guard.vocal.full_name %></p>
            </div>
          </div>
          <div class="px-4 py-2 border-t border-gray-100 flex items-center justify-end">
            <span class="flex items-center gap-1 text-xs font-medium text-gray-400 group-hover:text-gray-700">
              <i class="ph ph-arrow-right"></i> Ver
            </span>
          </div>
        <% end %>
      <% else %>
        <div class="h-full"></div>
      <% end %>
    </div>

    <%# Current guard %>
    <div class="w-full sm:w-[40%] shrink-0">
      <% if @current_guard %>
        <%= link_to @current_guard, class: "block h-full bg-white border-2 border-indigo-200 rounded-md shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col" do %>
          <div class="px-5 py-4 flex items-center justify-between bg-gradient-to-r from-indigo-50 to-white border-b border-indigo-100">
            <div>
              <p class="text-xs font-medium text-indigo-400 uppercase tracking-wide"><%= l(@current_guard.due_date, format: :long) %></p>
              <p class="text-2xl font-bold text-gray-900"># <%= @current_guard.day_number %></p>
            </div>
            <div class="flex items-center gap-2">
              <span class="flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold <%= @current_guard.open? ? 'bg-green-100 text-green-700' : 'bg-gray-100 text-gray-500' %>">
                <span class="w-1.5 h-1.5 rounded-full <%= @current_guard.open? ? 'bg-green-500 animate-pulse' : 'bg-gray-400' %>"></span>
                <%= @current_guard.open? ? "Abierta" : "Cerrada" %>
              </span>
              <div class="flex items-center justify-center w-9 h-9 rounded-full bg-indigo-100 text-indigo-700">
                <i class="ph ph-calendar-check text-base"></i>
              </div>
            </div>
          </div>
          <div class="px-5 py-4 flex flex-col gap-3 grow">
            <div class="flex items-center gap-3">
              <div class="flex items-center justify-center w-7 h-7 rounded-full bg-purple-100 text-purple-600 shrink-0">
                <i class="ph ph-cross text-xs"></i>
              </div>
              <div class="min-w-0">
                <p class="text-xs text-gray-400"><%= Guard.human_attribute_name(:priest) %></p>
                <p class="text-sm font-semibold text-gray-900 truncate"><%= @current_guard.priest.full_name %></p>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <div class="flex items-center justify-center w-7 h-7 rounded-full bg-red-100 text-red-600 shrink-0">
                <i class="ph ph-user text-xs"></i>
              </div>
              <div class="min-w-0">
                <p class="text-xs text-gray-400"><%= Guard.human_attribute_name(:vocal) %></p>
                <p class="text-sm font-semibold text-gray-900 truncate"><%= @current_guard.vocal.full_name %></p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <div class="flex items-center justify-center w-7 h-7 rounded-full bg-green-100 text-green-600 shrink-0 mt-0.5">
                <i class="ph ph-users text-xs"></i>
              </div>
              <div class="min-w-0">
                <p class="text-xs text-gray-400"><%= Guard.human_attribute_name(:guardians) %></p>
                <div class="flex flex-wrap gap-1 mt-0.5">
                  <% @current_guard.guardians.order(:last_name, :first_name).each do |guardian| %>
                    <span class="badge_green"><%= guardian.full_name %></span>
                  <% end %>
                </div>
              </div>
            </div>
          </div>
          <div class="px-5 py-3 border-t border-gray-100 flex items-center justify-end">
            <span class="flex items-center gap-1 text-sm font-medium text-indigo-600">
              <i class="ph ph-arrow-right"></i> Ver guardia
            </span>
          </div>
        <% end %>
      <% else %>
        <div class="h-full px-6 py-8 bg-gray-50 border border-dashed border-gray-200 rounded-md flex flex-col items-center justify-center text-center">
          <i class="ph ph-calendar-x text-2xl text-gray-300 mb-1 block"></i>
          <p class="text-sm text-gray-400">No hay guardia programada para hoy</p>
        </div>
      <% end %>
    </div>

    <%# Next guard %>
    <div class="hidden sm:block sm:w-[30%] shrink-0">
      <% if @next_guard %>
        <%= link_to @next_guard, class: "group bg-white border border-gray-200 rounded-md shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden flex flex-col opacity-60 hover:opacity-80" do %>
          <div class="px-4 py-3 flex items-center justify-between bg-gradient-to-r from-indigo-50/50 to-white border-b border-gray-100">
            <p class="text-xs font-medium text-indigo-400 uppercase tracking-wide">Próxima</p>
            <span class="text-base font-bold text-indigo-300"># <%= @next_guard.day_number %></span>
          </div>
          <div class="px-4 py-3 flex flex-col gap-1.5 grow">
            <p class="text-xs text-gray-400"><%= l(@next_guard.due_date, format: :long) %></p>
            <div class="flex items-center gap-1.5">
              <i class="ph ph-cross text-xs text-purple-400 shrink-0"></i>
              <p class="text-xs text-gray-600 truncate"><%= @next_guard.priest.full_name %></p>
            </div>
            <div class="flex items-center gap-1.5">
              <i class="ph ph-user text-xs text-red-400 shrink-0"></i>
              <p class="text-xs text-gray-600 truncate"><%= @next_guard.vocal.full_name %></p>
            </div>
          </div>
          <div class="px-4 py-2 border-t border-gray-100 flex items-center justify-end">
            <span class="flex items-center gap-1 text-xs font-medium text-indigo-400 group-hover:text-indigo-700">
              <i class="ph ph-arrow-right"></i> Ver
            </span>
          </div>
        <% end %>
      <% else %>
        <div class="h-full"></div>
      <% end %>
    </div>

  </div>

  <%# Quick links %>
  <div class="mt-auto">
  <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3">Acceso rápido</p>
  <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
    <%= link_to guards_path, class: "group bg-white border border-gray-200 rounded-md shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 overflow-hidden flex flex-col" do %>
      <div class="px-5 py-4 flex items-center gap-4 bg-gradient-to-r from-indigo-50 to-white border-b border-gray-100">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 shrink-0">
          <i class="ph ph-shield text-xl"></i>
        </div>
        <p class="text-base font-semibold text-gray-900">Guardias</p>
      </div>
      <div class="px-5 py-4 grow">
        <p class="text-sm text-gray-500 leading-relaxed">Organización y seguimiento de turnos nocturnos</p>
      </div>
      <div class="px-5 py-3 border-t border-gray-100 flex items-center justify-end">
        <span class="flex items-center gap-1 text-sm font-medium text-indigo-600 group-hover:text-indigo-800">
          <i class="ph ph-arrow-right"></i> Ver guardias
        </span>
      </div>
    <% end %>

    <%= link_to services_path, class: "group bg-white border border-gray-200 rounded-md shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 overflow-hidden flex flex-col" do %>
      <div class="px-5 py-4 flex items-center gap-4 bg-gradient-to-r from-green-50 to-white border-b border-gray-100">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-green-100 text-green-700 shrink-0">
          <i class="ph ph-hand-heart text-xl"></i>
        </div>
        <p class="text-base font-semibold text-gray-900">Servicios</p>
      </div>
      <div class="px-5 py-4 grow">
        <p class="text-sm text-gray-500 leading-relaxed">Gestión de servicios realizados</p>
      </div>
      <div class="px-5 py-3 border-t border-gray-100 flex items-center justify-end">
        <span class="flex items-center gap-1 text-sm font-medium text-green-600 group-hover:text-green-800">
          <i class="ph ph-arrow-right"></i> Ver servicios
        </span>
      </div>
    <% end %>

    <%= link_to guard_setups_path, class: "group bg-white border border-gray-200 rounded-md shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 overflow-hidden flex flex-col" do %>
      <div class="px-5 py-4 flex items-center gap-4 bg-gradient-to-r from-gray-50 to-white border-b border-gray-100">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-gray-200 text-gray-600 shrink-0">
          <i class="ph ph-sliders text-xl"></i>
        </div>
        <p class="text-base font-semibold text-gray-900">Configuración</p>
      </div>
      <div class="px-5 py-4 grow">
        <p class="text-sm text-gray-500 leading-relaxed">Sacerdotes, turnos y centros de salud</p>
      </div>
      <div class="px-5 py-3 border-t border-gray-100 flex items-center justify-end">
        <span class="flex items-center gap-1 text-sm font-medium text-gray-600 group-hover:text-gray-800">
          <i class="ph ph-arrow-right"></i> Ver configuración
        </span>
      </div>
    <% end %>
    <%= link_to "https://info.serviciosacerdotalnocturno.org", target: "_blank", rel: "noopener noreferrer", class: "group bg-white border border-gray-200 rounded-md shadow-sm hover:shadow-md hover:-translate-y-0.5 transition-all duration-200 overflow-hidden flex flex-col" do %>
      <div class="px-5 py-4 flex items-center gap-4 bg-gradient-to-r from-amber-50 to-white border-b border-gray-100">
        <div class="flex items-center justify-center w-10 h-10 rounded-full bg-amber-100 text-amber-700 shrink-0">
          <i class="ph ph-info text-xl"></i>
        </div>
        <p class="text-base font-semibold text-gray-900">Documentación</p>
      </div>
      <div class="px-5 py-4 grow">
        <p class="text-sm text-gray-500 leading-relaxed">Guías y manuales de uso del sistema</p>
      </div>
      <div class="px-5 py-3 border-t border-gray-100 flex items-center justify-end">
        <span class="flex items-center gap-1 text-sm font-medium text-amber-600 group-hover:text-amber-800">
          <i class="ph ph-arrow-square-out"></i> Ver documentación
        </span>
      </div>
    <% end %>
  </div>
  </div>
</div>
