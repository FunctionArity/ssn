<% if user_signed_in? %>
  <%= render "dashboard" %>
<% else %>
  <div class="min-h-screen bg-gradient-to-br from-indigo-950 via-indigo-900 to-blue-900 flex flex-col">

    <div class="flex-1 flex flex-col items-center justify-center px-6 py-16 text-center">

      <div class="inline-flex items-center justify-center w-32 h-32 rounded-full bg-white/10 border border-white/20 mb-8">
        <%= image_tag "icon.svg", class: "w-16 h-16" %>
      </div>

      <div class="inline-flex items-center gap-2 bg-white/10 border border-white/20 rounded-full px-4 py-1.5 text-xs font-medium text-indigo-200 uppercase tracking-widest mb-6">
        <span class="w-1.5 h-1.5 rounded-full bg-indigo-300 animate-pulse"></span>
        Servicio Sacerdotal de Urgencias y Nocturnos
      </div>

      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-white leading-tight max-w-3xl mb-6">
        Coordinación de guardias<br>
        <span class="text-indigo-300">sacerdotales nocturnas</span>
      </h1>

      <p class="max-w-xl text-indigo-200 text-base sm:text-lg leading-relaxed mb-10">
        Sistema de gestión para la asignación y seguimiento de guardias y turnos nocturnos del servicio sacerdotal, asegurando una cobertura continua y organizada.
      </p>

      <div class="flex flex-col items-center gap-3">
        <%= link_to new_user_session_path, class: "flex items-center justify-center gap-2 px-8 py-3 bg-white text-indigo-900 text-sm font-semibold rounded-md hover:bg-indigo-50 shadow-lg transition-colors" do %>
          <i class="ph ph-sign-in"></i> Iniciar sesión
        <% end %>
        <%= link_to "https://info.serviciosacerdotalnocturno.org", target: "_blank", rel: "noopener noreferrer", class: "flex items-center gap-1 text-xs text-indigo-300 hover:text-white transition-colors" do %>
          <i class="ph ph-info"></i> Documentación
        <% end %>
      </div>
    </div>

    <div class="border-t border-white/10">
      <div class="flex flex-wrap items-center justify-center gap-x-10 gap-y-4 px-6 py-6">
        <div class="flex items-center gap-2 text-indigo-200">
          <i class="ph ph-calendar-check text-lg text-indigo-400"></i>
          <span class="text-sm font-medium">Guardias</span>
        </div>
        <div class="flex items-center gap-2 text-indigo-200">
          <i class="ph ph-cross text-lg text-indigo-400"></i>
          <span class="text-sm font-medium">Sacerdotes</span>
        </div>
        <div class="flex items-center gap-2 text-indigo-200">
          <i class="ph ph-hospital text-lg text-indigo-400"></i>
          <span class="text-sm font-medium">Servicios</span>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 border-t border-white/10">
        <%= link_to sedes_path, class: "group flex flex-col items-center gap-1 px-8 pt-8 pb-[42px] border-b sm:border-b-0 sm:border-r border-white/10 text-center hover:bg-white/5 transition-colors" do %>
          <div class="flex items-center gap-2">
            <i class="ph ph-buildings text-xl text-indigo-300"></i>
            <p class="text-base font-semibold text-white">Sedes</p>
            <i class="ph ph-arrow-right text-indigo-300 group-hover:translate-x-1 transition-transform"></i>
          </div>
          <p class="text-xs text-indigo-300 leading-relaxed">Listado de sedes disponibles</p>
        <% end %>
        <%= link_to federacion_path, class: "group flex flex-col items-center gap-1 px-8 pt-8 pb-[42px] text-center hover:bg-white/5 transition-colors" do %>
          <div class="flex items-center gap-2">
            <i class="ph ph-users-three text-xl text-indigo-300"></i>
            <p class="text-base font-semibold text-white">Federación</p>
            <i class="ph ph-arrow-right text-indigo-300 group-hover:translate-x-1 transition-transform"></i>
          </div>
          <p class="text-xs text-indigo-300 leading-relaxed">Federación Argentina del Servicio Sacerdotal</p>
        <% end %>
      </div>
    </div>

  </div>
<% end %>
