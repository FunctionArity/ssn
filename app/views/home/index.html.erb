<div class="flex flex-col items-center justify-center h-full min-h-[calc(100vh-3.5rem)] text-center px-4">
  <h1 class="text-3xl font-bold text-gray-900 mb-4">Servicio Sacerdotal Nocturno</h1>
  <p class="max-w-xl text-gray-600 text-base leading-relaxed mb-8">
    El Servicio Sacerdotal Nocturno (SSN) es un sistema de gestión para la asignación y seguimiento de guardias y turnos nocturnos del servicio sacerdotal. Permite coordinar a los sacerdotes y su disponibilidad, asegurando una cobertura continua y organizada durante las horas nocturnas.
  </p>
  <% unless user_signed_in? %>
    <div class="flex gap-4">
      <%= link_to "Registrarse", new_user_registration_path, class: "px-6 py-2 bg-blue-600 text-white text-sm font-medium rounded-md hover:bg-blue-700" %>
      <%= link_to "Iniciar sesión", new_user_session_path, class: "px-6 py-2 border border-gray-300 text-gray-700 text-sm font-medium rounded-md hover:bg-gray-50" %>
    </div>
  <% end %>
</div>
