<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to @headquarter, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back", headquarter: @headquarter.city) %>
    <% end %>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <div class="px-6 py-5 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-4 bg-gradient-to-r from-amber-50 to-white border-b border-gray-100">
      <div class="flex items-center gap-4 min-w-0">
        <div class="flex items-center justify-center w-12 h-12 rounded-full bg-amber-100 text-amber-700 shrink-0">
          <i class="ph ph-address-book text-xl"></i>
        </div>
        <div class="min-w-0">
          <p class="text-xs font-medium text-amber-600 uppercase tracking-wide"><%= @headquarter.city %>, <%= @headquarter.state %></p>
          <h1 class="text-xl font-bold text-gray-900 mt-0.5"><%= @contact_directory.title %></h1>
          <% if @contact_directory.description.present? %>
            <div class="text-sm text-gray-600 mt-1"><%= simple_format(@contact_directory.description, {}, wrapper_tag: "p") %></div>
          <% end %>
        </div>
      </div>
      <div class="flex flex-wrap items-center gap-2 sm:justify-end shrink-0">
        <% if @contact_directory.updated_on %>
          <span class="badge_blue"><%= t(".updated_on", date: l(@contact_directory.updated_on, format: "%B %Y")) %></span>
        <% end %>
        <span class="<%= @contact_directory.visibility_public? ? "badge_green" : "badge_purple" %>">
          <%= t("activerecord.attributes.contact_directory.visibilities.#{@contact_directory.visibility}") %>
        </span>
      </div>
    </div>

    <div class="px-6 py-6">
      <%= render "groups", contact_directory: @contact_directory %>
    </div>

    <% if policy(@contact_directory).edit? || policy(@contact_directory).destroy? %>
      <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-end gap-2">
        <% if policy(@contact_directory).edit? %>
          <%= link_to edit_headquarter_contact_directory_path(@headquarter, @contact_directory), class: "w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
            <i class="ph ph-pencil-simple"></i> <%= t("edit") %>
          <% end %>
        <% end %>
        <% if policy(@contact_directory).destroy? %>
          <%= button_to [ @headquarter, @contact_directory ], method: :delete, form: { class: "w-full sm:w-auto", data: { turbo_confirm: t(".destroy_confirm"), turbo_confirm_title: t(".destroy_confirm_title"), turbo_confirm_level: "danger" } }, class: "w-full cursor-pointer flex items-center justify-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
            <i class="ph ph-trash"></i> <%= t("destroy") %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
