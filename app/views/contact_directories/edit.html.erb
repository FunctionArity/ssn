<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to [ @headquarter, @contact_directory ], class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 flex items-center gap-4 bg-gradient-to-r from-amber-100 to-white border-b border-gray-100">
      <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-amber-200 text-amber-700 shrink-0">
        <i class="ph ph-address-book text-xl"></i>
      </div>
      <div class="min-w-0">
        <h1 class="text-xl font-bold text-gray-900"><%= t(".title") %></h1>
        <p class="text-sm text-gray-500"><%= @headquarter.city %>, <%= @headquarter.state %></p>
      </div>
    </div>

    <div class="px-6 py-6">
      <%= render "form", headquarter: @headquarter, contact_directory: @contact_directory %>
    </div>
  </div>
</div>
