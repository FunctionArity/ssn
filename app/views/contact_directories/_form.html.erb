<%= form_with(model: [ headquarter, contact_directory ], class: "space-y-6") do |form| %>
  <% if contact_directory.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-800 rounded-lg p-4">
      <h2 class="font-semibold mb-2"><%= t("contact_directories.form.errors.title", count: contact_directory.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% contact_directory.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div class="sm:col-span-2">
      <%= form.label :title, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :title, placeholder: t("contact_directories.form.title_placeholder"), class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    </div>

    <div class="sm:col-span-2">
      <%= form.label :description, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_area :description, rows: 2, placeholder: t("contact_directories.form.description_placeholder"), class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    </div>

    <div>
      <%= form.label :group_label, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :group_label, placeholder: t("contact_directories.form.group_label_placeholder"), class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      <p class="mt-1 text-xs text-gray-500"><%= t("contact_directories.form.group_label_hint") %></p>
    </div>

    <div>
      <%= form.label :updated_on, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.date_field :updated_on, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    </div>

    <div class="sm:col-span-2">
      <span class="block text-sm font-medium text-gray-700 mb-1"><%= ContactDirectory.human_attribute_name(:visibility) %></span>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
        <% ContactDirectory.visibilities.each_key do |visibility| %>
          <label class="flex items-start gap-2 rounded-md border border-gray-200 px-3 py-2 cursor-pointer has-[:checked]:border-blue-500 has-[:checked]:bg-blue-50">
            <%= form.radio_button :visibility, visibility, class: "mt-1" %>
            <span>
              <span class="block text-sm font-medium text-gray-900"><%= t("activerecord.attributes.contact_directory.visibilities.#{visibility}") %></span>
              <span class="block text-xs text-gray-500"><%= t("contact_directories.form.visibility_hints.#{visibility}") %></span>
            </span>
          </label>
        <% end %>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-100 pt-6" data-controller="nested-fields" data-nested-fields-placeholder-value="NEW_GROUP">
    <div class="flex items-center justify-between mb-3">
      <p class="text-sm font-semibold text-gray-700"><%= t("contact_directories.form.groups_title") %></p>
    </div>

    <div class="space-y-4" data-nested-fields-target="container">
      <%= form.fields_for :contact_groups do |group_form| %>
        <%= render "group_fields", form: group_form %>
      <% end %>
    </div>

    <template data-nested-fields-target="template">
      <%= form.fields_for :contact_groups, ContactGroup.new.tap { |group| group.contacts.build }, child_index: "NEW_GROUP" do |group_form| %>
        <%= render "group_fields", form: group_form %>
      <% end %>
    </template>

    <button type="button" data-action="nested-fields#add" class="mt-4 flex items-center gap-1.5 rounded-md border border-dashed border-gray-300 px-4 py-2 text-sm font-medium text-gray-600 hover:border-blue-400 hover:text-blue-700">
      <i class="ph ph-plus"></i> <%= t("contact_directories.form.add_group") %>
    </button>
  </div>

  <div class="border-t border-gray-100 pt-4 flex justify-end">
    <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
  </div>
<% end %>
