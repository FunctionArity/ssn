<%# Group cards of a contact directory: compact by default, one card expands to show its contacts.
    locals: contact_directory %>
<% groups = contact_directory.contact_groups %>
<% if groups.empty? %>
  <p class="text-sm text-gray-400"><%= t("contact_directories.show.empty") %></p>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 grid-flow-row-dense gap-3" data-controller="card-expand">
    <% groups.each do |group| %>
      <% details_id = "contact-group-#{group.id}-details" %>
      <% clipboard_text = [
           group.name,
           *group.contacts.map { |contact| [ contact.name, contact.detail.presence && "(#{contact.detail})", contact.phone, contact.email ].compact_blank.join(" ") }
         ].join("\n") %>
      <section data-card-expand-target="card" data-state="idle"
               style="view-transition-name: contact-group-<%= group.id %>"
               class="group/card bg-white border border-gray-200 rounded-xl overflow-hidden transition-[opacity,border-color,box-shadow] duration-200
                      data-[state=expanded]:col-span-full data-[state=expanded]:border-amber-300 data-[state=expanded]:shadow-md
                      data-[state=collapsed]:opacity-60 data-[state=collapsed]:hover:opacity-100">
        <h3>
          <button type="button" aria-expanded="false" aria-controls="<%= details_id %>" data-action="card-expand#toggle"
                  class="cursor-pointer w-full text-left flex items-center gap-3 px-4 py-3 hover:bg-amber-50/60 transition-[padding] duration-200
                         group-data-[state=expanded]/card:bg-gradient-to-r group-data-[state=expanded]/card:from-amber-50 group-data-[state=expanded]/card:to-white
                         group-data-[state=collapsed]/card:py-2">
            <span class="flex items-center justify-center w-9 h-9 rounded-full bg-amber-100 text-amber-700 shrink-0 transition-all duration-200
                         group-data-[state=collapsed]/card:w-7 group-data-[state=collapsed]/card:h-7">
              <i class="ph ph-users-three"></i>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-gray-900 truncate group-data-[state=collapsed]/card:text-sm"><%= group.name %></span>
              <span class="block text-xs text-gray-500 truncate group-data-[state=collapsed]/card:hidden">
                <%= t("contact_directories.show.contacts_count", count: group.contacts.size) %><% if group.notes.present? %> · <span class="italic"><%= group.notes %></span><% end %>
              </span>
            </span>
            <i class="ph ph-caret-down text-gray-400 shrink-0 transition-transform duration-200 group-data-[state=expanded]/card:rotate-180"></i>
          </button>
        </h3>

        <div id="<%= details_id %>" data-card-expand-details hidden class="border-t border-gray-100">
          <div class="flex justify-end px-4 py-2 border-b border-gray-100 bg-gray-50/60">
            <button type="button"
                    data-controller="clipboard"
                    data-clipboard-text-value="<%= clipboard_text %>"
                    data-action="click->clipboard#copy"
                    class="cursor-pointer flex items-center gap-1.5 rounded-md px-2 py-1 text-xs font-medium text-gray-600 hover:bg-white hover:text-gray-900">
              <i class="ph ph-copy" data-clipboard-target="icon"></i> <%= t("contact_directories.show.copy") %>
            </button>
          </div>
          <% if group.contacts.empty? %>
            <p class="px-4 py-3 text-sm text-gray-400"><%= t("contact_directories.show.empty") %></p>
          <% else %>
            <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
              <% group.contacts.each do |contact| %>
                <li class="px-4 py-3 border-b border-gray-100">
                  <p class="text-sm font-medium text-gray-900">
                    <%= contact.name %>
                    <% if contact.detail.present? %>
                      <span class="font-normal text-gray-500">· <%= contact.detail %></span>
                    <% end %>
                  </p>
                  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm">
                    <% if contact.phone.present? %>
                      <%= link_to "tel:#{contact.phone_digits}", class: "flex items-center gap-1 text-gray-600 hover:text-blue-700 tabular-nums" do %>
                        <i class="ph ph-phone text-gray-400"></i> <%= contact.phone %>
                      <% end %>
                      <%= link_to "https://wa.me/#{contact.phone_digits}", target: "_blank", rel: "noopener", title: "WhatsApp", "aria-label": "WhatsApp #{contact.name}", class: "flex items-center text-green-600 hover:text-green-800" do %>
                        <i class="ph ph-whatsapp-logo text-base"></i>
                      <% end %>
                    <% end %>
                    <% if contact.email.present? %>
                      <%= mail_to contact.email, class: "flex items-center gap-1 text-gray-600 hover:text-blue-700 break-all" do %>
                        <i class="ph ph-envelope-simple text-gray-400"></i> <%= contact.email %>
                      <% end %>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>
      </section>
    <% end %>
  </div>
<% end %>
