<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to churches_path, class: "flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-700 transition-colors" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
    <%# Header %>
    <div class="px-6 py-5 flex items-center gap-4 bg-gradient-to-r from-purple-50 via-purple-50/50 to-white border-b border-gray-100">
      <div class="flex items-center justify-center w-14 h-14 rounded-2xl bg-purple-100 text-purple-700 shrink-0 shadow-sm">
        <i class="ph ph-church text-2xl"></i>
      </div>
      <div>
        <p class="text-xs font-semibold text-purple-500 uppercase tracking-wide mb-0.5"><%= t("activerecord.models.church.one") %></p>
        <h1 class="text-xl font-bold text-gray-900 leading-tight"><%= @church.name %></h1>
      </div>
    </div>

    <%# Details %>
    <div class="divide-y divide-gray-100">
      <% if @church.address.present? %>
        <div class="flex items-start gap-4 px-6 py-4">
          <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-gray-100 text-gray-500 shrink-0">
            <i class="ph ph-map-pin text-sm"></i>
          </div>
          <div>
            <p class="text-xs text-gray-400 mb-0.5"><%= t("activerecord.attributes.church.address") %></p>
            <p class="text-sm font-medium text-gray-800"><%= @church.address %></p>
          </div>
        </div>
      <% end %>
      <% if @church.phone.present? %>
        <div class="flex items-start gap-4 px-6 py-4">
          <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-gray-100 text-gray-500 shrink-0">
            <i class="ph ph-phone text-sm"></i>
          </div>
          <div>
            <p class="text-xs text-gray-400 mb-0.5"><%= t("activerecord.attributes.church.phone") %></p>
            <p class="text-sm font-medium text-gray-800"><%= @church.phone %></p>
          </div>
        </div>
      <% end %>
    </div>

    <%# Priest %>
    <% if @church.priests.any? %>
      <div class="flex items-start gap-4 px-6 py-4 border-t border-gray-100">
        <div class="flex items-center justify-center w-8 h-8 rounded-lg bg-purple-100 text-purple-700 shrink-0">
          <i class="ph ph-user text-sm"></i>
        </div>
        <div>
          <p class="text-xs text-gray-400 mb-1"><%= t(".priest") %></p>
          <div class="flex flex-col gap-1">
            <% @church.priests.each do |priest| %>
              <%= link_to user_path(priest), class: "text-sm font-medium text-purple-700 hover:underline" do %>
                <%= priest.full_name %>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%# Map %>
    <% if @church.address.present? %>
      <div class="border-t border-gray-100">
        <div class="flex items-center justify-between px-6 py-3">
          <p class="text-xs font-semibold text-gray-400 uppercase tracking-wide flex items-center gap-1.5">
            <i class="ph ph-map-trifold"></i> <%= t(".map") %>
          </p>
          <%= link_to "https://maps.google.com/?q=#{URI.encode_uri_component(@church.address)}", target: "_blank", rel: "noopener", class: "text-xs text-purple-600 hover:underline flex items-center gap-1" do %>
            <i class="ph ph-arrow-square-out"></i> <%= t(".open_in_maps") %>
          <% end %>
        </div>
        <div data-controller="church-map"
             data-church-map-initial-address-value="<%= @church.address %>"
             class="h-80 w-full">
          <div data-church-map-target="map" class="h-full w-full"></div>
        </div>
      </div>
    <% end %>

    <%# Actions %>
    <div class="px-6 py-4 border-t border-gray-100 flex items-center justify-end gap-3">
      <%= link_to edit_church_path(@church), class: "flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
        <i class="ph ph-pencil-simple"></i> <%= t("edit") %>
      <% end %>
      <%= button_to @church, method: :delete, form: { data: { turbo_confirm: t(".destroy_confirm") } }, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
        <i class="ph ph-trash"></i> <%= t("destroy") %>
      <% end %>
    </div>
  </div>
</div>
