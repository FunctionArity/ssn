<div class="py-8 max-w-xl">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to churches_path, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <div class="bg-white border border-gray-200 rounded-xl overflow-hidden">
    <div class="px-6 py-5 flex items-center gap-4 border-b border-gray-100 bg-gradient-to-r from-purple-50 to-white">
      <div class="flex items-center justify-center w-11 h-11 rounded-full bg-purple-100 text-purple-700 shrink-0">
        <i class="ph ph-church text-xl"></i>
      </div>
      <h1 class="text-xl font-bold text-gray-900"><%= @church.name %></h1>
    </div>
    <div class="px-6 py-4 space-y-3">
      <% if @church.address.present? %>
        <div class="flex items-start gap-3">
          <i class="ph ph-map-pin text-gray-400 mt-0.5"></i>
          <p class="text-sm text-gray-700"><%= @church.address %></p>
        </div>
      <% end %>
      <% if @church.phone.present? %>
        <div class="flex items-center gap-3">
          <i class="ph ph-phone text-gray-400"></i>
          <p class="text-sm text-gray-700"><%= @church.phone %></p>
        </div>
      <% end %>
    </div>
    <% if @church.address.present? %>
      <div data-controller="church-map"
           data-church-map-initial-address-value="<%= @church.address %>"
           class="h-64 w-full">
        <div data-church-map-target="map" class="h-full w-full"></div>
      </div>
    <% end %>
  </div>

  <div class="mt-4 flex items-center gap-3">
    <%= link_to t("edit"), edit_church_path(@church), class: "flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" %>
    <%= button_to @church, method: :delete, form: { data: { turbo_confirm: t(".destroy_confirm") } }, class: "cursor-pointer flex items-center gap-1.5 rounded-md bg-red-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-red-500" do %>
      <i class="ph ph-trash"></i> <%= t("destroy") %>
    <% end %>
  </div>
</div>
