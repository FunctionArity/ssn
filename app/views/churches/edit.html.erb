<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to @church, class: "flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-700 transition-colors" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 flex items-center gap-4 bg-gradient-to-r from-purple-100 to-white border-b border-gray-100">
      <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-purple-200 text-purple-700">
        <i class="ph ph-church text-xl"></i>
      </div>
      <h1 class="text-xl font-bold text-gray-900"><%= t(".title") %></h1>
    </div>

    <div class="px-6 py-6">
      <%= render "form", church: @church %>
    </div>
  </div>
</div>
