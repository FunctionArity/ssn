<div class="py-8 max-w-xl">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to @church, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= t(".title") %></h1>

  <%= render "form", church: @church %>
</div>
