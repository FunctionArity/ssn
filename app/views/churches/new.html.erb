<div class="py-8 max-w-xl">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to churches_path, class: "flex items-center gap-1.5 text-sm text-gray-500 hover:text-gray-700 transition-colors" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <div class="flex items-center gap-3 mb-6">
    <div class="flex items-center justify-center w-10 h-10 rounded-xl bg-purple-100 text-purple-700">
      <i class="ph ph-church text-lg"></i>
    </div>
    <h1 class="text-2xl font-bold text-gray-900"><%= t(".title") %></h1>
  </div>

  <div class="bg-white border border-gray-200 rounded-2xl shadow-sm p-6">
    <%= render "form", church: @church %>
  </div>
</div>
