<%# Change history timeline for a PaperTrail-tracked record.
    locals: record, versions, authors (User by id string), subtitle, events_scope (i18n scope with back: and events:) %>
<% model = record.class %>
<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to record, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t("#{events_scope}.back") %>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 flex items-center gap-4 bg-gradient-to-r from-gray-100 to-white border-b border-gray-100">
      <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-gray-200 text-gray-700 shrink-0">
        <i class="ph ph-clock-counter-clockwise text-xl"></i>
      </div>
      <div class="min-w-0">
        <h1 class="text-xl font-bold text-gray-900"><%= t("history.title") %></h1>
        <p class="text-sm text-gray-500 truncate"><%= subtitle %></p>
      </div>
      <% if versions.any? %>
        <span class="ml-auto shrink-0 badge_blue"><%= t("history.changes", count: versions.size) %></span>
      <% end %>
    </div>

    <% if versions.empty? %>
      <div class="px-6 py-12 text-center">
        <i class="ph ph-clock-counter-clockwise text-3xl text-gray-300"></i>
        <p class="mt-2 text-sm text-gray-400"><%= t("history.empty") %></p>
      </div>
    <% else %>
      <div class="px-6 py-6 space-y-6">
        <%# Versions come newest first, so the first day is the only one expanded. %>
        <% versions.group_by { |version| version.created_at.to_date }.each_with_index do |(day, day_versions), day_index| %>
          <details class="group" <%= "open" if day_index.zero? %>>
            <summary class="flex items-center justify-between gap-2 cursor-pointer select-none list-none">
              <h2 class="text-xs font-semibold uppercase tracking-wide text-gray-400">
                <%= day == Date.current ? t("history.today") : day == Date.yesterday ? t("history.yesterday") : l(day, format: :long) %>
                <span class="ml-1 font-medium">(<%= t("history.changes", count: day_versions.size) %>)</span>
              </h2>
              <i class="ph ph-caret-down text-gray-400 transition-transform duration-200 group-open:rotate-180"></i>
            </summary>

            <ol id="history_day_<%= day.iso8601 %>" class="relative mt-4">
              <%= render partial: "shared/history_version",
                    collection: day_versions.first(HistoryHelper::HISTORY_PAGE_SIZE),
                    as: :version,
                    locals: { model: model, authors: authors, events_scope: events_scope } %>
            </ol>
            <div id="history_more_<%= day.iso8601 %>">
              <%= render "shared/history_load_more", record: record, day: day.iso8601, day_versions: day_versions, offset: HistoryHelper::HISTORY_PAGE_SIZE %>
            </div>
          </details>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
