<%# Change history timeline for a PaperTrail-tracked record.
    locals: record, versions, authors (User by id string), subtitle, events_scope (i18n scope with back: and events:) %>
<% model = record.class %>
<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to record, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t("#{events_scope}.back") %>
    <% end %>
  </div>

  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 flex items-center gap-4 bg-gradient-to-r from-gray-100 to-white border-b border-gray-100">
      <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-gray-200 text-gray-700 shrink-0">
        <i class="ph ph-clock-counter-clockwise text-xl"></i>
      </div>
      <div class="min-w-0">
        <h1 class="text-xl font-bold text-gray-900"><%= t("history.title") %></h1>
        <p class="text-sm text-gray-500 truncate"><%= subtitle %></p>
      </div>
      <% if versions.any? %>
        <span class="ml-auto shrink-0 badge_blue"><%= t("history.changes", count: versions.size) %></span>
      <% end %>
    </div>

    <% if versions.empty? %>
      <div class="px-6 py-12 text-center">
        <i class="ph ph-clock-counter-clockwise text-3xl text-gray-300"></i>
        <p class="mt-2 text-sm text-gray-400"><%= t("history.empty") %></p>
      </div>
    <% else %>
      <div class="px-6 py-6 space-y-8">
        <% versions.group_by { |version| version.created_at.to_date }.each do |day, day_versions| %>
          <section>
            <h2 class="mb-4 text-xs font-semibold uppercase tracking-wide text-gray-400">
              <%= day == Date.current ? t("history.today") : day == Date.yesterday ? t("history.yesterday") : l(day, format: :long) %>
            </h2>

            <ol class="relative">
              <% day_versions.each_with_index do |version, index| %>
                <% author = authors[version.whodunnit] %>
                <% changes = history_changes(version) %>
                <% icon, icon_class = history_event_icon(model, version, changes) %>
                <li id="<%= dom_id(version) %>" class="relative flex gap-4 <%= "pb-6" unless index == day_versions.size - 1 %>">
                  <% unless index == day_versions.size - 1 %>
                    <span class="absolute left-4 top-9 -bottom-0 w-px -translate-x-1/2 bg-gray-200" aria-hidden="true"></span>
                  <% end %>
                  <span class="relative flex items-center justify-center w-8 h-8 rounded-full ring-4 shrink-0 <%= icon_class %>">
                    <i class="ph <%= icon %> text-sm"></i>
                  </span>

                  <div class="min-w-0 flex-1 pt-1">
                    <div class="flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
                      <p class="text-sm text-gray-600">
                        <span class="font-semibold text-gray-900"><%= author&.full_name || t("history.unknown_author") %></span>
                        <%= t("#{events_scope}.events.#{version.event}", default: version.event) %>
                      </p>
                      <time datetime="<%= version.created_at.iso8601 %>" title="<%= l(version.created_at, format: :long) %>" class="ml-auto text-xs text-gray-400 tabular-nums">
                        <%= l(version.created_at, format: "%H:%M") %>
                      </time>
                    </div>

                    <% if changes.empty? %>
                      <p class="mt-2 text-sm text-gray-400"><%= t("history.no_changes") %></p>
                    <% else %>
                      <dl class="mt-3 rounded-lg border border-gray-100 bg-gray-50/60 divide-y divide-gray-100">
                        <% changes.each do |attribute, (before, after)| %>
                          <% if attribute == "status" %>
                            <div class="px-3 py-2.5 grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-x-4 gap-y-1 text-sm bg-indigo-50 border-l-4 border-indigo-400 first:rounded-t-lg last:rounded-b-lg">
                              <dt class="flex items-center gap-1.5 font-semibold text-indigo-800">
                                <i class="ph ph-flag"></i> <%= history_attribute_name(model, attribute) %>
                              </dt>
                              <dd class="flex flex-wrap items-center gap-2 min-w-0">
                                <% unless version.event == "create" %>
                                  <span class="<%= history_status_badge_class(model, before) %> opacity-70"><%= history_value(model, attribute, before) %></span>
                                  <i class="ph ph-arrow-right text-indigo-400 shrink-0"></i>
                                <% end %>
                                <span class="<%= history_status_badge_class(model, after) %>"><%= history_value(model, attribute, after) %></span>
                              </dd>
                            </div>
                            <% next %>
                          <% end %>
                          <div class="px-3 py-2 grid grid-cols-1 sm:grid-cols-[10rem_1fr] gap-x-4 gap-y-1 text-sm">
                            <dt class="font-medium text-gray-500"><%= history_attribute_name(model, attribute) %></dt>
                            <dd class="flex flex-wrap items-center gap-2 min-w-0">
                              <% unless version.event == "create" %>
                                <span class="rounded px-1.5 py-0.5 bg-red-50 text-red-700 line-through decoration-red-300 break-words"><%= history_value(model, attribute, before) %></span>
                                <i class="ph ph-arrow-right text-gray-400 shrink-0"></i>
                              <% end %>
                              <span class="rounded px-1.5 py-0.5 bg-green-50 text-green-800 break-words"><%= history_value(model, attribute, after) %></span>
                            </dd>
                          </div>
                        <% end %>
                      </dl>
                    <% end %>
                  </div>
                </li>
              <% end %>
            </ol>
          </section>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
