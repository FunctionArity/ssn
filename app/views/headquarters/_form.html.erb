<%= form_with(model: headquarter, class: "space-y-6") do |form| %>
  <% if headquarter.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-800 rounded-lg p-4">
      <h2 class="font-semibold mb-2"><%= t("headquarters.form.errors.title", count: headquarter.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% headquarter.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :name, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :name, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" %>
  </div>

  <div>
    <%= form.label :president_id, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.select :president_id,
          @users.map { |u| [ u.full_name, u.id ] },
          { include_blank: t("helpers.select.prompt") },
          class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-amber-500 focus:ring-1 focus:ring-amber-500" %>
  </div>

  <div class="border-t border-gray-100 pt-4 flex justify-end">
    <%= form.submit class: "cursor-pointer rounded-md bg-amber-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-amber-500 transition-colors" %>
  </div>
<% end %>
