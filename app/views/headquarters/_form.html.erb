<%= form_with(model: headquarter, class: "space-y-6") do |form| %>
  <% if headquarter.errors.any? %>
    <div class="bg-red-50 border border-red-300 text-red-800 rounded-lg p-4">
      <h2 class="font-semibold mb-2"><%= t("headquarters.form.errors.title", count: headquarter.errors.count) %></h2>
      <ul class="list-disc list-inside">
        <% headquarter.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
    <div>
      <%= form.label :country, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :country, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    </div>

    <div>
      <%= form.label :state, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :state, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    </div>
  </div>

  <div>
    <%= form.label :city, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :city, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div>
    <%= form.label :address, class: "block text-sm font-medium text-gray-700 mb-1" %>
    <%= form.text_field :address, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
  </div>

  <div class="border-t border-gray-100 pt-4">
    <p class="text-sm font-semibold text-gray-700 mb-1"><%= t("headquarters.form.contact_title") %></p>
    <p class="text-xs text-gray-500 mb-4"><%= t("headquarters.form.contact_hint") %></p>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div>
        <%= form.label :phone, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :phone, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>

      <div>
        <%= form.label :whatsapp, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :whatsapp, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="mt-4">
      <%= form.label :email, class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= form.text_field :email, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    </div>
  </div>

  <div class="border-t border-gray-100 pt-4">
    <p class="text-sm font-semibold text-gray-700 mb-4"><%= t("headquarters.form.social_title") %></p>

    <div class="space-y-4">
      <div>
        <%= form.label :web_address, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :web_address, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>

      <div>
        <%= form.label :facebook, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :facebook, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>

      <div>
        <%= form.label :instagram, class: "block text-sm font-medium text-gray-700 mb-1" %>
        <%= form.text_field :instagram, class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
      </div>
    </div>
  </div>

  <div class="border-t border-gray-100 pt-4 flex justify-end">
    <%= form.submit class: "cursor-pointer rounded-md bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-blue-500 transition-colors" %>
  </div>
<% end %>
