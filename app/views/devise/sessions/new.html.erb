<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-indigo-950 via-indigo-900 to-blue-900">
  <div class="w-full max-w-sm">

    <div class="text-center mb-8">
      <div class="inline-flex items-center justify-center w-14 h-14 rounded-full bg-white/10 border border-white/20 mb-4">
        <%= image_tag "icon.svg", class: "w-8 h-8" %>
      </div>
      <h1 class="text-xl font-bold text-white"><%= t("devise_views.sessions.title") %></h1>
      <p class="text-sm text-indigo-300 mt-1">Servicio Sacerdotal Nocturno</p>
    </div>

    <div class="bg-white/10 border border-white/20 backdrop-blur-sm rounded-2xl p-8 shadow-xl">
      <% if alert.present? %>
        <div class="mb-5 flex items-center gap-3 px-4 py-3 rounded-xl bg-red-900 border border-red-700 text-red-200">
          <i class="ph ph-warning-circle text-lg shrink-0"></i>
          <p class="text-sm font-medium"><%= alert %></p>
        </div>
      <% end %>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "space-y-5" }) do |f| %>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-indigo-200 mb-1.5" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full rounded-xl bg-white/10 border border-white/20 px-4 py-2.5 text-white placeholder-indigo-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent",
              placeholder: "tu@email.com" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-indigo-200 mb-1.5" %>
          <%= f.password_field :password, autocomplete: "current-password",
              class: "w-full rounded-xl bg-white/10 border border-white/20 px-4 py-2.5 text-white placeholder-indigo-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent",
              placeholder: "••••••••" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="flex items-center gap-2">
            <%= f.check_box :remember_me, class: "rounded border-white/20 bg-white/10 text-indigo-400 focus:ring-indigo-400" %>
            <%= f.label :remember_me, t("devise_views.sessions.remember_me"), class: "text-sm text-indigo-300" %>
          </div>
        <% end %>

        <div class="pt-1">
          <%= f.submit t("devise_views.sessions.submit"),
              class: "cursor-pointer w-full rounded-xl bg-white text-indigo-900 px-4 py-2.5 text-sm font-semibold shadow-sm hover:bg-indigo-50 transition-colors" %>
        </div>

      <% end %>
    </div>

    <div class="mt-5 text-center space-y-2 text-sm">
      <%- if devise_mapping.registerable? %>
        <p class="text-indigo-300">
          ¿No tenés cuenta?
          <%= link_to t("devise_views.shared.sign_up"), new_registration_path(resource_name), class: "text-white font-medium hover:underline" %>
        </p>
      <% end %>
      <%- if devise_mapping.recoverable? %>
        <p>
          <%= link_to t("devise_views.shared.forgot_password"), new_password_path(resource_name), class: "text-indigo-400 hover:text-indigo-200 text-xs" %>
        </p>
      <% end %>
    </div>

  </div>
</div>
