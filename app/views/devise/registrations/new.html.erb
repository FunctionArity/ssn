<div class="min-h-screen flex items-center justify-center px-4 py-12 bg-gradient-to-br from-indigo-950 via-indigo-900 to-blue-900">
  <div class="w-full max-w-sm">

    <div class="text-center mb-8">
      <%= link_to root_path, class: "inline-flex items-center justify-center w-14 h-14 rounded-full bg-white/10 border border-white/20 mb-4 hover:bg-white/20 transition-colors" do %>
        <%= image_tag "icon.svg", class: "w-8 h-8" %>
      <% end %>
      <h1 class="text-xl font-bold text-white"><%= t("devise_views.registrations.new.title") %></h1>
      <p class="text-sm text-indigo-300 mt-1">Servicio Sacerdotal de Urgencia y Nocturnos</p>
    </div>

    <div class="bg-white/10 border border-white/20 backdrop-blur-sm rounded-2xl p-8 shadow-xl">
      <%= render "devise/shared/error_messages", resource: resource %>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <%= f.label :first_name, class: "block text-sm font-medium text-indigo-200 mb-1.5" %>
            <%= f.text_field :first_name, autofocus: true, autocomplete: "given-name",
                class: "w-full rounded-md bg-white/10 border border-white/20 px-4 py-2.5 text-white placeholder-indigo-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent",
                placeholder: "Juan" %>
          </div>
          <div>
            <%= f.label :last_name, class: "block text-sm font-medium text-indigo-200 mb-1.5" %>
            <%= f.text_field :last_name, autocomplete: "family-name",
                class: "w-full rounded-md bg-white/10 border border-white/20 px-4 py-2.5 text-white placeholder-indigo-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent",
                placeholder: "García" %>
          </div>
        </div>

        <div>
          <%= f.label :email, class: "block text-sm font-medium text-indigo-200 mb-1.5" %>
          <%= f.email_field :email, autocomplete: "email",
              class: "w-full rounded-md bg-white/10 border border-white/20 px-4 py-2.5 text-white placeholder-indigo-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent",
              placeholder: "tu@email.com" %>
        </div>

        <div>
          <%= f.label :password, class: "block text-sm font-medium text-indigo-200 mb-1.5" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-indigo-400 mb-1.5"><em><%= t("devise_views.registrations.new.minimum_password_length", count: @minimum_password_length) %></em></p>
          <% end %>
          <div class="relative">
            <%= f.password_field :password, autocomplete: "new-password", id: "password",
                class: "w-full rounded-md bg-white/10 border border-white/20 px-4 py-2.5 pr-11 text-white placeholder-indigo-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent",
                placeholder: "••••••••" %>
            <button type="button" onclick="togglePassword('password', this)"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-indigo-300 hover:text-white">
              <i class="ph ph-eye text-lg"></i>
            </button>
          </div>
        </div>

        <div>
          <%= f.label :password_confirmation, class: "block text-sm font-medium text-indigo-200 mb-1.5" %>
          <div class="relative">
            <%= f.password_field :password_confirmation, autocomplete: "new-password", id: "password_confirmation",
                class: "w-full rounded-md bg-white/10 border border-white/20 px-4 py-2.5 pr-11 text-white placeholder-indigo-300 text-sm focus:outline-none focus:ring-2 focus:ring-indigo-400 focus:border-transparent",
                placeholder: "••••••••" %>
            <button type="button" onclick="togglePassword('password_confirmation', this)"
                class="absolute inset-y-0 right-0 flex items-center px-3 text-indigo-300 hover:text-white">
              <i class="ph ph-eye text-lg"></i>
            </button>
          </div>
        </div>

        <div class="pt-1">
          <%= f.submit t("devise_views.registrations.new.submit"),
              class: "cursor-pointer w-full rounded-md bg-white text-indigo-900 px-4 py-2.5 text-sm font-semibold shadow-sm hover:bg-indigo-50 transition-colors" %>
        </div>

      <% end %>
    </div>

    <div class="mt-5 text-center space-y-2 text-sm">
      <%= render "devise/shared/links" %>
    </div>

  </div>
</div>

<script>
  function togglePassword(fieldId, btn) {
    const field = document.getElementById(fieldId);
    const icon = btn.querySelector('i');
    if (field.type === 'password') {
      field.type = 'text';
      icon.classList.replace('ph-eye', 'ph-eye-slash');
    } else {
      field.type = 'password';
      icon.classList.replace('ph-eye-slash', 'ph-eye');
    }
  }
</script>
