<div class="mt-6 space-y-2 text-sm">
  <%- if controller_name != 'sessions' %>
    <p><%= link_to t("devise_views.shared.log_in"), new_session_path(resource_name), class: "text-blue-600 hover:text-blue-800" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p><%= link_to t("devise_views.shared.sign_up"), new_registration_path(resource_name), class: "text-blue-600 hover:text-blue-800" %></p>
  <% end %>

  <%- if devise_mapping.recoverable? && controller_name != 'passwords' && controller_name != 'registrations' %>
    <p><%= link_to t("devise_views.shared.forgot_password"), new_password_path(resource_name), class: "text-blue-600 hover:text-blue-800" %></p>
  <% end %>

  <%- if devise_mapping.confirmable? && controller_name != 'confirmations' %>
    <p><%= link_to t("devise_views.shared.confirmation_instructions"), new_confirmation_path(resource_name), class: "text-blue-600 hover:text-blue-800" %></p>
  <% end %>

  <%- if devise_mapping.lockable? && resource_class.unlock_strategy_enabled?(:email) && controller_name != 'unlocks' %>
    <p><%= link_to t("devise_views.shared.unlock_instructions"), new_unlock_path(resource_name), class: "text-blue-600 hover:text-blue-800" %></p>
  <% end %>

  <%- if devise_mapping.omniauthable? %>
    <%- resource_class.omniauth_providers.each do |provider| %>
      <p>
        <%= button_to omniauth_authorize_path(resource_name, provider), form: { data: { turbo: false } },
              class: "cursor-pointer inline-flex items-center justify-center gap-2.5 rounded-md bg-white/10 border border-white/20 px-4 py-2 text-sm font-medium text-white hover:bg-white/20 transition-colors" do %>
          <% if provider.to_s == "google_oauth2" %>
            <span class="flex items-center justify-center w-5 h-5 rounded-full bg-white"><%= image_tag "google.svg", alt: "", class: "w-3 h-3" %></span>
            <%= t("devise_views.sessions.google") %>
          <% else %>
            Sign in with <%= OmniAuth::Utils.camelize(provider) %>
          <% end %>
        <% end %>
      </p>
    <% end %>
  <% end %>
</div>
