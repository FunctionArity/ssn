<div class="max-w-md mx-auto">
  <h2 class="text-2xl font-bold text-gray-900 mb-6"><%= t("devise_views.passwords.edit.title") %></h2>

  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "space-y-6" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>
    <%= f.hidden_field :reset_password_token %>

    <div>
      <%= f.label :password, t("devise_views.passwords.edit.new_password"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <% if @minimum_password_length %>
        <p class="text-xs text-gray-500 mb-1"><em><%= t("devise_views.passwords.edit.minimum_password_length", count: @minimum_password_length) %></em></p>
      <% end %>
      <%= f.password_field :password, autofocus: true, autocomplete: "new-password", class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.label :password_confirmation, t("devise_views.passwords.edit.confirm_new_password"), class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "w-full rounded-md border border-gray-300 px-3 py-2 shadow-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500" %>
    </div>

    <div>
      <%= f.submit t("devise_views.passwords.edit.submit"), class: "cursor-pointer w-full rounded-md bg-blue-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-blue-500" %>
    </div>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
