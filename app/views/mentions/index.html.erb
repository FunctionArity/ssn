<div class="py-8">
  <div class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
    <div class="px-6 py-5 flex items-center gap-4 bg-gradient-to-r from-gray-100 to-white border-b border-gray-100">
      <div class="flex items-center justify-center w-11 h-11 rounded-xl bg-gray-200 text-gray-700 shrink-0">
        <i class="ph ph-bell text-xl"></i>
      </div>
      <h1 class="text-xl font-bold text-gray-900"><%= t(".title") %></h1>
      <% if @mentions.any?(&:unread?) %>
        <%= button_to t(".read_all"), read_all_mentions_path, method: :post,
              form: { class: "ml-auto" },
              class: "cursor-pointer inline-flex items-center gap-1.5 rounded-md bg-white border border-gray-300 px-3 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50 transition-colors" %>
      <% end %>
    </div>

    <% if @mentions.empty? %>
      <div class="px-6 py-12 text-center">
        <i class="ph ph-bell-slash text-3xl text-gray-300"></i>
        <p class="mt-2 text-sm text-gray-400"><%= t(".empty") %></p>
      </div>
    <% else %>
      <ul class="divide-y divide-gray-100">
        <% @mentions.each do |mention| %>
          <% comment = mention.comment %>
          <% commentable = comment.commentable %>
          <li id="<%= dom_id(mention) %>">
            <%= link_to polymorphic_path(commentable, anchor: dom_id(comment)), class: "flex gap-3 px-6 py-4 hover:bg-gray-50 #{"bg-amber-50/60" if mention.unread?}" do %>
              <span class="mt-1.5 w-2 h-2 rounded-full shrink-0 <%= mention.unread? ? "bg-red-600" : "bg-transparent" %>" aria-hidden="true"></span>
              <div class="min-w-0 flex-1">
                <div class="flex flex-wrap items-baseline gap-x-2">
                  <p class="text-sm text-gray-600">
                    <%= t(".mentioned_you.#{commentable.model_name.i18n_key}_html", author: tag.span(comment.user.full_name, class: "font-semibold text-gray-900"), name: tag.span(commentable.comment_subject, class: "font-semibold text-gray-900")) %>
                  </p>
                  <time datetime="<%= comment.created_at.iso8601 %>" class="ml-auto text-xs text-gray-400"><%= l(comment.created_at, format: :short) %></time>
                </div>
                <p class="mt-1 text-sm text-gray-500 truncate"><%= strip_tags(comment.body.gsub(/<\/p>|<br\s*\/?>/i, "\\0 ")).squish %></p>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
