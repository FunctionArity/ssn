<div data-controller="priest-assign">
  <%= render "shared/page_header",
        title: t(".title"),
        icon: "ph-calendar",
        icon_class: "bg-purple-100 text-purple-700" %>

  <%# Priests panel %>
  <% if @priests.any? %>
    <div class="mb-6 rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <h2 class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-3"><%= t(".priests") %></h2>
      <div class="flex flex-wrap gap-2">
        <% @priests.each do |priest| %>
          <div class="cursor-grab rounded-lg border border-purple-200 bg-purple-50 px-3 py-2 shadow-sm select-none hover:bg-purple-100 hover:border-purple-300 transition-colors"
               draggable="true"
               data-priest-id="<%= priest.id %>"
               data-action="dragstart->priest-assign#dragStart dragend->priest-assign#dragEnd">
            <p class="text-sm font-medium text-purple-800"><%= priest.full_name %></p>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Assignment grid %>
  <div class="overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
    <% month_start = Date.today.beginning_of_month %>
    <% days_in_month = month_start.end_of_month.day %>
    <% monday_offset = (month_start.wday - 1 + 7) % 7 %>
    <table class="table-fixed min-w-max w-full border-collapse">
      <thead>
        <tr class="border-b border-gray-100">
          <th class="w-28 px-4 py-3 text-left text-xs font-semibold text-gray-500 whitespace-nowrap"><%= l(month_start, format: "%B %Y") %></th>
          <% t("date.day_names").rotate(1).each do |day| %>
            <th class="w-36 min-w-36 text-center text-xs font-semibold text-gray-400 uppercase tracking-widest py-3 px-2">
              <%= day %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-100">
        <% t(".week_names").each.with_index(1) do |week_name, week_idx| %>
          <tr class="group">
            <td class="px-4 py-2 text-xs font-semibold text-gray-400 uppercase tracking-widest align-middle whitespace-nowrap border-r border-gray-100">
              <%= week_name %>
            </td>
            <% (1..7).each do |day_idx| %>
              <% slot = @day_slots.find { |s| s[:week_number] == week_idx && s[:day_of_week] == day_idx } %>
              <% date_num = (week_idx - 1) * 7 + day_idx - monday_offset %>
              <% date_in_month = date_num.between?(1, days_in_month) ? date_num : nil %>
              <% is_today = date_in_month == Date.today.day %>
              <% is_weekend = day_idx >= 6 %>
              <td class="relative align-top h-20 w-36 min-w-36 p-2 transition-colors border-r border-gray-100 last:border-r-0
                         <%= date_in_month ? (is_today ? 'bg-purple-50' : (is_weekend ? 'bg-gray-50' : 'bg-white')) : 'bg-gray-50/50' %>
                         <%= is_today ? 'ring-2 ring-inset ring-purple-400' : '' %>"
                  data-week-number="<%= week_idx %>"
                  data-day-of-week="<%= day_idx %>"
                  data-action="dragover->priest-assign#dragOver dragleave->priest-assign#dragLeave drop->priest-assign#drop">
                <% if date_in_month %>
                  <span class="block text-xs font-semibold leading-none mb-2 <%= is_today ? 'text-purple-600' : 'text-gray-400' %>">
                    <%= date_in_month %>
                  </span>
                <% end %>
                <% if slot[:assignment] %>
                  <div class="rounded-md bg-purple-100 border border-purple-200 px-2 py-1 flex items-center justify-between gap-1 cursor-grab select-none hover:bg-purple-200 transition-colors"
                       draggable="true"
                       data-priest-id="<%= slot[:assignment].priest_id %>"
                       data-source-setup-id="<%= slot[:assignment].id %>"
                       data-action="dragstart->priest-assign#dragStart dragend->priest-assign#dragEnd">
                    <p class="text-xs font-medium text-purple-800 leading-tight truncate"><%= slot[:assignment].priest.full_name %></p>
                    <%= button_to priest_setup_path(slot[:assignment]),
                          method: :delete,
                          class: "text-purple-300 hover:text-red-400 leading-none shrink-0 transition-colors",
                          data: { turbo_confirm: t("priest_setups.confirm.destroy") } do %>
                      <i class="ph ph-trash text-xs"></i>
                    <% end %>
                  </div>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Hidden form for drag & drop submission %>
  <%= form_with model: PriestSetup.new, url: priest_setups_path, id: "priest-assign-form", data: { turbo: false } do |f| %>
    <%= f.hidden_field :priest_id, id: "form_priest_id" %>
    <%= f.hidden_field :week_number, id: "form_week_number" %>
    <%= f.hidden_field :day_of_week, id: "form_day_of_week" %>
    <input type="hidden" id="form_source_setup_id" name="source_setup_id" value="">
  <% end %>
</div>
