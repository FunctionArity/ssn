<div class="py-8">
  <div class="flex items-center gap-2 mb-6">
    <%= link_to @guard, class: "flex items-center gap-1 text-sm text-gray-500 hover:text-gray-700" do %>
      <i class="ph ph-caret-left"></i> <%= t(".back") %>
    <% end %>
  </div>

  <div id="<%= dom_id @guard, :pdf %>" class="bg-white border border-gray-200 rounded-xl shadow-sm overflow-hidden">
    <%= render "guards/header", guard: @guard, services_count: @services_count %>

    <iframe src="<%= @pdf_url %>" title="<%= t(".title", number: @guard.day_number) %>" class="block w-full h-[80vh] bg-gray-100"></iframe>

    <div class="px-6 py-4 border-t border-gray-100 flex flex-col sm:flex-row sm:items-center sm:justify-end gap-2">
      <%= link_to @guard, class: "w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
        <i class="ph ph-arrow-left"></i> <%= t(".back") %>
      <% end %>
      <%= link_to @pdf_url, target: "_blank", class: "w-full sm:w-auto flex items-center justify-center gap-1.5 rounded-md bg-white border border-gray-300 px-4 py-2 text-sm font-medium text-gray-700 shadow-sm hover:bg-gray-50" do %>
        <i class="ph ph-arrow-square-out"></i> <%= t(".open_in_new_tab") %>
      <% end %>
    </div>
  </div>
</div>
