#!/usr/bin/env bash
set -e

DB_CONFIG=$(bin/rails runner "
  c = ActiveRecord::Base.configurations.find_db_config('development').configuration_hash
  puts [c[:host] || '127.0.0.1', c[:port] || 5432, c[:database], c[:username], c[:password]].join(' ')
")
DB_HOST=$(echo $DB_CONFIG | awk '{print $1}')
DB_PORT=$(echo $DB_CONFIG | awk '{print $2}')
DB_NAME=$(echo $DB_CONFIG | awk '{print $3}')
DB_USER=$(echo $DB_CONFIG | awk '{print $4}')
DB_PASS=$(echo $DB_CONFIG | awk '{print $5}')

BACKUP_FILE="${1:-}"

# If no file given, use the latest local backup or download from S3
if [ -z "$BACKUP_FILE" ]; then
  BACKUP_FILE=$(ls -t ./tmp/*.sql.gz 2>/dev/null | head -1)
  if [ -n "$BACKUP_FILE" ]; then
    echo "Found local backup: ${BACKUP_FILE}"
  else
    echo "No local backup found — downloading latest from S3..."
    bin/download_backup ./tmp
    BACKUP_FILE=$(ls -t ./tmp/*.sql.gz 2>/dev/null | head -1)
  fi
fi

if [ -z "$BACKUP_FILE" ] || [ ! -f "$BACKUP_FILE" ]; then
  echo "Error: backup file not found: ${BACKUP_FILE}"
  echo "Usage: bin/restore_backup [path/to/backup.sql.gz]"
  exit 1
fi

echo "Restoring ${BACKUP_FILE} -> ${DB_NAME} on ${DB_HOST}:${DB_PORT}..."

echo "  Dropping and recreating database..."
PGPASSWORD="$DB_PASS" psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" postgres \
  -c "SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${DB_NAME}' AND pid <> pg_backend_pid();" \
  > /dev/null 2>&1
PGPASSWORD="$DB_PASS" dropdb -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" --if-exists "$DB_NAME"
PGPASSWORD="$DB_PASS" createdb -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" "$DB_NAME"

echo "  Restoring data..."
# Pre-create the production role so ownership statements don't error
PGPASSWORD="$DB_PASS" psql -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" "$DB_NAME" \
  -c "DO \$\$ BEGIN CREATE ROLE ssn; EXCEPTION WHEN duplicate_object THEN NULL; END \$\$;" \
  > /dev/null 2>&1 || true

gunzip -c "$BACKUP_FILE" \
  | docker exec -i ssn-db-1 psql -U "$DB_USER" "$DB_NAME" \
  > /dev/null

echo "Done. ${DB_NAME} restored from ${BACKUP_FILE}."
