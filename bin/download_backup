#!/usr/bin/env bash
set -e

BUCKET="ssn-db-backups"
PREFIX="backups"
DEST="${1:-./tmp}"

export AWS_ACCESS_KEY_ID=$(bin/rails runner "puts Rails.application.credentials.aws.access_key_id!")
export AWS_SECRET_ACCESS_KEY=$(bin/rails runner "puts Rails.application.credentials.aws.secret_access_key!")
export AWS_DEFAULT_REGION="us-east-1"

echo "Fetching latest backup from s3://${BUCKET}/${PREFIX}/ ..."

LATEST=$(aws s3 ls "s3://${BUCKET}/${PREFIX}/" \
  | sort | tail -1 | awk '{print $4}')

if [ -z "$LATEST" ]; then
  echo "No backups found in s3://${BUCKET}/${PREFIX}/"
  exit 1
fi

mkdir -p "$DEST"
echo "Downloading: ${LATEST} -> ${DEST}/${LATEST}"
aws s3 cp "s3://${BUCKET}/${PREFIX}/${LATEST}" "${DEST}/${LATEST}"

echo "Done. To restore:"
echo "  gunzip -c ${DEST}/${LATEST} | psql \$DATABASE_URL"
